' opt=actapl
Sub ActualizarApl(cn, id, nombre, idCliente, idAplic, responEnvio, fechaEnvio, _
					fechaTest, fechaProd, motivo, incidente, proyecto, sec, tipoApl)
	Dim cmd
	Set cmd = Server.CreateObject("ADODB.Command")
	cmd.ActiveConnection = cn
	cmd.CommandType = 4
	cmd.CommandText = "dbo.sp_cg_Apl_Actualizar"
	cmd.Parameters.Append cmd.CreateParameter("@id", 3, 1, 4, CLng(id))
	cmd.Parameters.Append cmd.CreateParameter("@nombre", 200, 1, 200, nombre)
	cmd.Parameters.Append cmd.CreateParameter("@id_cliente", 3, 1, 4, CLng(idCliente))
	cmd.Parameters.Append cmd.CreateParameter("@id_aplic", 3, 1, 4, CLng(idAplic))
	cmd.Parameters.Append cmd.CreateParameter("@respon_envio", 200, 1, 100, responEnvio)
	cmd.Parameters.Append cmd.CreateParameter("@fecha_envio", 3, 1, 4, CLng(fechaEnvio))
	cmd.Parameters.Append cmd.CreateParameter("@fecha_instalacion_test", 3, 1, 4, CLng(fechaTest))
	cmd.Parameters.Append cmd.CreateParameter("@fecha_instalacion_prod", 3, 1, 4, CLng(fechaProd))
	cmd.Parameters.Append cmd.CreateParameter("@motivo_apl", 200, 1, 4000, motivo)
	cmd.Parameters.Append cmd.CreateParameter("@incidente", 3, 1, 4, CLng(incidente))
	cmd.Parameters.Append cmd.CreateParameter("@proyecto", 3, 1, 4, CLng(proyecto))
	cmd.Parameters.Append cmd.CreateParameter("@sec", 3, 1, 4, CLng(sec))
	cmd.Parameters.Append cmd.CreateParameter("@tipo_apl", 3, 1, 4, CLng(tipoApl))
	On Error Resume Next
	cmd.Execute
	If Err.Number <> 0 Then
		Response.Write "<div style='color:red;font-family:monospace;padding:10px;border:1px solid red;margin:10px;'>"
		Response.Write "<b>ERROR DE BASE DE DATOS</b><br>"
		Response.Write "Contexto: ActualizarApl (id=" & Server.HTMLEncode(id) & ")<br>"
		Response.Write "Codigo: " & Err.Number & "<br>"
		Response.Write "Detalle: " & Server.HTMLEncode(Err.Description) & "</div>"
		Response.End
	End If
	On Error Goto 0
End Sub

Sub InsertarClientesDet(cn, id, servidor, ambiente, db_rqt, licencia)
	Dim cmd
	Set cmd = Server.CreateObject("ADODB.Command")
	cmd.ActiveConnection = cn
	cmd.CommandType = 4
	cmd.CommandText = "dbo.sp_cg_clientes_det"
	cmd.Parameters.Append cmd.CreateParameter("@modo", 200, 1, 200, "insertar")
	cmd.Parameters.Append cmd.CreateParameter("@id", 3, 1, 4, null )
	cmd.Parameters.Append cmd.CreateParameter("@id_cliente", 3, 1, 4, CLng(id))
	cmd.Parameters.Append cmd.CreateParameter("@servidor", 200, 1, 200, servidor)
	cmd.Parameters.Append cmd.CreateParameter("@ambiente", 200, 1, 200, ambiente)
	cmd.Parameters.Append cmd.CreateParameter("@db_rqt", 200, 1, 200, db_rqt)
	cmd.Parameters.Append cmd.CreateParameter("@licencia", 200, 1, 200, licencia)
	On Error Resume Next
	cmd.Execute
	If Err.Number <> 0 Then
		Response.Write "ERROR insertar clientes_det: " & Err.Number & ": " & Err.Description & " DATOS (" & CLng(id) & "," & servidor & "," & ambiente & "," & db_rqt & "," & licencia & ")"
		Response.End
	End If
	On Error Goto 0
End Sub


Sub ActualizarClientesDet(cn, id, id_cliente, servidor, ambiente, db_rqt, licencia)
	Dim cmd
	Set cmd = Server.CreateObject("ADODB.Command")
	cmd.ActiveConnection = cn
	cmd.CommandType = 4
	cmd.CommandText = "dbo.sp_cg_clientes_det"
	cmd.Parameters.Append cmd.CreateParameter("@modo", 200, 1, 200, "modificar")
	cmd.Parameters.Append cmd.CreateParameter("@id", 3, 1, 4, CLng(id))
	cmd.Parameters.Append cmd.CreateParameter("@id_cliente", 3, 1, 4, CLng(id_cliente))
	cmd.Parameters.Append cmd.CreateParameter("@servidor", 200, 1, 200, servidor)
	cmd.Parameters.Append cmd.CreateParameter("@ambiente", 200, 1, 200, ambiente)
	cmd.Parameters.Append cmd.CreateParameter("@db_rqt", 200, 1, 200, db_rqt)
	cmd.Parameters.Append cmd.CreateParameter("@licencia", 200, 1, 200, licencia)
	On Error Resume Next
	cmd.Execute
	If Err.Number <> 0 Then
		Response.Write "ERROR actualizar clientes_det: " & Err.Number & ": " & Err.Description & " DATOS (" & CLng(id) & "," & servidor & "," & ambiente & "," & db_rqt & "," & licencia & ")"
		Response.End
	End If
	On Error Goto 0
End Sub

Sub EliminarClientesDet(cn, id_cliente)
	Dim cmd
	Set cmd = Server.CreateObject("ADODB.Command")
	cmd.ActiveConnection = cn
	cmd.CommandType = 4
	cmd.CommandText = "dbo.sp_cg_clientes_det"
	cmd.Parameters.Append cmd.CreateParameter("@modo", 200, 1, 200, "eliminar_x_cliente")
	cmd.Parameters.Append cmd.CreateParameter("@id", 3, 1, 4, CLng(id_cliente))
	cmd.Parameters.Append cmd.CreateParameter("@id_cliente", 3, 1, 4, CLng(id_cliente))
	On Error Resume Next
	cmd.Execute
	If Err.Number <> 0 Then
		Response.Write "ERROR eliminar clientes_det: " & Err.Number & ": " & Err.Description
		Response.End
	End If
	On Error Goto 0
End Sub


%>
