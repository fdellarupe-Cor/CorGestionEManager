	cmd.Parameters.Append cmd.CreateParameter("@id", 3, 1, 4, CLng(id))
	cmd.Parameters.Append cmd.CreateParameter("@estadoDesaNuevo", 3, 1, 4, CLng(estadoDesaNuevo))
	cmd.Parameters.Append cmd.CreateParameter("@sFec", 3, 1, 4, CLng(sFec))
	cmd.Parameters.Append cmd.CreateParameter("@relainc", 200, 1, 100, relainc)
	On Error Resume Next
