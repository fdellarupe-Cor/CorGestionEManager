'[UI-ANT] xhtml = xhtml & "function colorPersona(id){"
'[UI-ANT] xhtml = xhtml & "  var s = String(id == null ? '' : id);"
'[UI-ANT] xhtml = xhtml & "  if (!s || s === '0') return '#8a8886';"
'[UI-ANT] xhtml = xhtml & "  var h = 0; for (var i = 0; i < s.length; i++) { h = (h + s.charCodeAt(i)) % 8; }"
'[UI-ANT] xhtml = xhtml & "  return PALETA_JS[h];"
'[UI-ANT] xhtml = xhtml & "}"
'[UI-ANT] xhtml = xhtml & "function iniciales(nombre){"
'[UI-ANT] xhtml = xhtml & "  var partes = (nombre || '').trim().split(' ');"
'[UI-ANT] xhtml = xhtml & "  var out = '';"
'[UI-ANT] xhtml = xhtml & "  for (var i = 0; i < partes.length && out.length < 2; i++) { if (partes[i]) out += partes[i].charAt(0).toUpperCase(); }"
'[UI-ANT] xhtml = xhtml & "  return out || '?';"
'[UI-ANT] xhtml = xhtml & "}"
'[UI-ANT] xhtml = xhtml & "function escapeHtml(s){"
'[UI-ANT] xhtml = xhtml & "  var d = document.createElement('div');"
'[UI-ANT] xhtml = xhtml & "  d.appendChild(document.createTextNode(s || ''));"
'[UI-ANT] xhtml = xhtml & "  return d.innerHTML;"
'[UI-ANT] xhtml = xhtml & "}"
' Al entrar, si se esta mostrando la semana de hoy, centra la grilla en la
' hora actual (linea roja) para que el usuario vea "hoy" de entrada.
'[UI-ANT] xhtml = xhtml & "window.addEventListener('load', function(){"
'[UI-ANT] xhtml = xhtml & "  if (!MOSTRANDO_HOY) return;"
'[UI-ANT] xhtml = xhtml & "  var linea = document.getElementById('lineaAhora'), wrap = document.getElementById('grillaWrap');"
'[UI-ANT] xhtml = xhtml & "  if (linea && wrap) { wrap.scrollTop = Math.max(0, linea.offsetTop - (wrap.clientHeight / 2)); }"
'[UI-ANT] xhtml = xhtml & "});"
'[UI-ANT] xhtml = xhtml & "</script>"
'[UI-ANT] xhtml = xhtml & "</body></html>"

'[UI-ANT] Response.Write xhtml

' =========================================================================
' [UI] VISTA con el sistema visual (IncFile/ui_componentes.inc)
' Antes: ventana emergente con encabezado propio y estilos sueltos. Ahora: pagina del sistema
' (cabecera comun, barra con navegacion de semanas, Nueva reunion y Volver, en la misma ventana).
' La logica de arriba (reparto en columnas y cruces de horario) no cambia.
' Sin texto tecnico para el usuario (antes mostraba el nombre del procedimiento y su EXEC).
' =========================================================================
Dim xhtml, rangoLbl, dLunes, dViernes, MESES_ES, accTop, urlSemana, cabTarjeta

MESES_ES = Array("enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre")
dLunes = CDate(epochLunes + CLng(EPOCH))
dViernes = CDate(epochLunes + 4 + CLng(EPOCH))
' Meses en espanol fijos (MonthName dependia del idioma del servidor)
If Month(dLunes) = Month(dViernes) Then
	rangoLbl = Day(dLunes) & " al " & Day(dViernes) & " de " & MESES_ES(Month(dViernes) - 1) & " de " & Year(dViernes)
Else
	rangoLbl = Day(dLunes) & " de " & MESES_ES(Month(dLunes) - 1) & " al " & Day(dViernes) & " de " & MESES_ES(Month(dViernes) - 1) & " de " & Year(dViernes)
End If
urlSemana = "agenda_semana.asp?xmenu=" & Server.URLEncode(xmenu) & "&xtmenu=" & Server.URLEncode(xtmenu) & "&d="

xhtml = headhtml()
xhtml = xhtml & "<body>"
xhtml = xhtml & "<div id='wrapper' role='banner'>" & cabecera() & "</div>"

'[UI-ANT] accTop = "<a class='ui-button ui-button--light ui-button--sm' href='" & nuevaUrl & "'>+ Nueva reuni&oacute;n</a>" & _
'[UI-ANT] "<a class='ui-button ui-button--secondary ui-button--sm' href='" & volverUrl & "'>Volver</a>"
' [UI] La vista semanal es la entrada de la Agenda: 'Vista en lista' lleva a la lista y 'Volver', a la portada
accTop = "<a class='ui-button ui-button--light ui-button--sm' href='" & nuevaUrl & "'>+ Nueva reuni&oacute;n</a>" & _
	"<a class='ui-button ui-button--secondary ui-button--sm' href='" & volverUrl & "'>Vista en lista</a>" & _
	"<a class='ui-button ui-button--secondary ui-button--sm' href='inicio.asp'>Volver</a>"
'[UI-ANT] xhtml = xhtml & UiPantallaAbre("Agenda semanal", accTop, "wide")
xhtml = xhtml & UiPantallaAbre("Agenda", accTop, "wide")
' [UI] Selector de vista (misma barra de pildoras que Consultas y Reportes)
xhtml = xhtml & "<nav class='ui-tabbar ui-tabbar--pildoras' aria-label='Vista de la agenda'>" & AgTab("semana", "Semanal", IIf(esMes, "mes", "semana")) & AgTab("mes", "Mensual", IIf(esMes, "mes", "semana")) & "</nav>"

If esMes Then
	' ===================== [UI] VISTA MENSUAL =====================
	Dim urlMes, urlSem, mesLbl, mostrandoMesActual, epochPrevMes, epochSigMes, epochDia, dDia, claseCelda, nomFerM
	Dim dicMes, recM, idsDia, idd, nDiaM, kk2, etiqM, hayCruceM, arrM(), DIAS_LARGO, estiloM, horaM
	DIAS_LARGO = Array("lunes", "martes", "mi&eacute;rcoles", "jueves", "viernes")
	mesLbl = UCase(Left(MESES_ES(Month(dPrimero) - 1), 1)) & Mid(MESES_ES(Month(dPrimero) - 1), 2) & " de " & Year(dPrimero)
	urlMes = "agenda_semana.asp?vista=mes&xmenu=" & Server.URLEncode(xmenu) & "&xtmenu=" & Server.URLEncode(xtmenu) & "&d="
	urlSem = "agenda_semana.asp?vista=semana&xmenu=" & Server.URLEncode(xmenu) & "&xtmenu=" & Server.URLEncode(xtmenu) & "&d="
	epochPrevMes = CLng(DateSerial(Year(dPrimero), Month(dPrimero) - 1, 1)) - CLng(EPOCH)
	epochSigMes = CLng(DateSerial(Year(dPrimero), Month(dPrimero) + 1, 1)) - CLng(EPOCH)
	mostrandoMesActual = (hoyEpoch >= epochMesIni And hoyEpoch <= epochMesFin)

	' --- Encabezado de la tarjeta: mes y navegacion (mismo armado que la semana) ---
	cabTarjeta = "<div class='ui-week-nav' role='group' aria-label='Cambiar de mes'>" & _
		"<a class='ui-button ui-button--light ui-button--sm' href='" & urlMes & epochPrevMes & "' aria-label='Mes anterior'>&#8592;</a>"
	If mostrandoMesActual Then
		cabTarjeta = cabTarjeta & "<span class='ui-button ui-button--light ui-button--sm ui-button--disabled' aria-disabled='true' title='Ya est&aacute;s en el mes actual'>Hoy</span>"
	Else
		cabTarjeta = cabTarjeta & "<a class='ui-button ui-button--light ui-button--sm' href='" & urlMes & hoyEpoch & "'>Hoy</a>"
	End If
	cabTarjeta = cabTarjeta & "<a class='ui-button ui-button--light ui-button--sm' href='" & urlMes & epochSigMes & "' aria-label='Mes siguiente'>&#8594;</a></div>"
	xhtml = xhtml & UiCardAbre(mesLbl, cabTarjeta)

	' --- Leyenda (la misma de la semana) ---
	xhtml = xhtml & "<ul class='ui-week-leyenda' aria-label='Referencias'>" & _
		"<li><span class='ui-week-muestra ui-week-reunion--pendiente'></span>Pendiente</li>" & _
		"<li><span class='ui-week-muestra ui-week-reunion--postergada'></span>Postergada</li>" & _
		"<li><span class='ui-week-muestra ui-week-reunion--realizada'></span>Realizada</li>" & _
		"<li><span class='ui-week-flag ui-week-flag--leyenda' aria-hidden='true'>!</span>Cruce de horario: un participante tiene otra reuni&oacute;n en el mismo horario</li>" & _
		"</ul>"

	' --- Reuniones agrupadas por fecha (ids separados por coma) ---
	Set dicMes = Server.CreateObject("Scripting.Dictionary")
	For i = 0 To totalReuniones - 1
		Set recM = dicReuniones(ordenIds(i))
		If Not dicMes.Exists(CStr(recM("fecha"))) Then dicMes.Add CStr(recM("fecha")), ""
		dicMes(CStr(recM("fecha"))) = dicMes(CStr(recM("fecha"))) & ordenIds(i) & ","
	Next

	xhtml = xhtml & "<div class='ui-week-body'>"
	xhtml = xhtml & "<div class='ui-mes' role='region' aria-label='Calendario de " & mesLbl & "'>"
	xhtml = xhtml & "<div class='ui-mes__cabecera' aria-hidden='true'>"
	For i = 0 To 4
		xhtml = xhtml & "<div class='ui-mes__cab-dia'>" & NOMBRES_DIA(i) & "</div>"
	Next
	xhtml = xhtml & "</div><div class='ui-mes__grilla'>"
	jsMeetings = ""
	For epochDia = epochDesde To epochHasta
		dDia = CDate(epochDia + CLng(EPOCH))
		If Weekday(dDia, vbMonday) <= 5 Then
			claseCelda = "ui-mes__dia"
			If epochDia < epochMesIni Or epochDia > epochMesFin Then claseCelda = claseCelda & " ui-mes__dia--fuera"
			If epochDia = hoyEpoch Then claseCelda = claseCelda & " ui-mes__dia--hoy"
			nomFerM = ""
			If dicFer.Exists(CStr(epochDia)) Then nomFerM = dicFer(CStr(epochDia))
			If nomFerM <> "" Then claseCelda = claseCelda & " ui-mes__dia--feriado"
			xhtml = xhtml & "<div class='" & claseCelda & "'>"
			' El numero del dia lleva a la vista semanal de esa semana
			xhtml = xhtml & "<a class='ui-mes__num' href='" & urlSem & epochDia & "' aria-label='" & DIAS_LARGO(Weekday(dDia, vbMonday) - 1) & " " & Day(dDia) & " de " & MESES_ES(Month(dDia) - 1) & IIf(epochDia = hoyEpoch, " (hoy)", "") & ": ver la semana'>" & Day(dDia) & "</a>"
			If nomFerM <> "" Then xhtml = xhtml & "<span class='ui-mes__feriado' title='" & Server.HTMLEncode(nomFerM) & "'>" & Server.HTMLEncode(nomFerM) & "</span>"
			' Reuniones del dia, por hora; se ven hasta 3 y el resto como "+N mas" (lleva a la semana)
			nDiaM = 0
			If dicMes.Exists(CStr(epochDia)) Then
				idsDia = Split(dicMes(CStr(epochDia)), ",")
				ReDim arrM(UBound(idsDia))
				For Each idd In idsDia
					If idd <> "" Then
						Set arrM(nDiaM) = dicReuniones(idd)
						nDiaM = nDiaM + 1
					End If
				Next
				OrdenarPorHora arrM, nDiaM
			End If
			If nDiaM > 0 Then
				xhtml = xhtml & "<ul class='ui-mes__reuniones'>"
				For kk2 = 0 To nDiaM - 1
					Set recM = arrM(kk2)
					jsMeetings = jsMeetings & JsRegistroReunion(recM)
					If kk2 < 3 Then
						hayCruceM = (recM("cruces").Count > 0)
						etiqM = Server.HTMLEncode(recM("asunto")) & ", " & FormatHoraDecimal(recM("hi")) & " a " & FormatHoraDecimal(recM("hf")) & ", " & LCase(recM("estado"))
						estiloM = ""
						horaM = FormatHoraDecimal(recM("hi"))
						If recM.Exists("esLic") Then
							estiloM = " style='" & LicEstilo(ColorPersona(recM("respId"))) & "'"
							horaM = "Todo el d&iacute;a"
							etiqM = Server.HTMLEncode(recM("asunto")) & ", todo el d&iacute;a, licencia"
						End If
						If hayCruceM Then etiqM = etiqM & ", con cruce de horario"
						xhtml = xhtml & "<li><button type='button' class='ui-mes__reunion " & EstadoClase(recM("estado")) & IIf(hayCruceM, " ui-mes__reunion--cruce", "") & "'" & estiloM & " onclick='seleccionarReunion(" & recM("id") & ", this)' aria-label='" & etiqM & "'>"
						If hayCruceM Then xhtml = xhtml & "<span class='ui-week-flag' aria-hidden='true'>!</span>"
						xhtml = xhtml & "<span class='ui-mes__hora'>" & horaM & "</span><span class='ui-mes__titulo'>" & Server.HTMLEncode(recM("asunto")) & "</span></button></li>"
					End If
				Next
				If nDiaM > 3 Then xhtml = xhtml & "<li><a class='ui-mes__mas' href='" & urlSem & epochDia & "'>+" & (nDiaM - 3) & " m&aacute;s</a></li>"
				xhtml = xhtml & "</ul>"
			End If
			xhtml = xhtml & "</div>"
		End If
	Next
	xhtml = xhtml & "</div></div>" ' Fin grilla y ui-mes

	' --- Panel de detalle (el mismo de la semana) ---
	xhtml = xhtml & "<section class='ui-week-panel' id='panel' aria-live='polite' aria-label='Detalle de la reuni&oacute;n'>"
	xhtml = xhtml & "<div class='ui-week-vacio' id='panelVacio'>"
	xhtml = xhtml & "<svg viewBox='0 0 24 24' width='36' height='36' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg>"
	xhtml = xhtml & "<p>Eleg&iacute; una reuni&oacute;n del calendario para ver el detalle y si alg&uacute;n participante tiene otra reuni&oacute;n en el mismo horario.</p>"
	xhtml = xhtml & "</div>"
	xhtml = xhtml & "<div id='panelContenido' hidden></div>"
	xhtml = xhtml & "</section>"   ' [UI] section con nombre (antes aside dentro del contenido principal)
	xhtml = xhtml & "</div>" ' Fin ui-week-body
	If totalReal = 0 Then xhtml = xhtml & "<p class='ui-table__nota'>No hay reuniones este mes.</p>"
	xhtml = xhtml & UiCardCierra()
Else
' --- Encabezado de la tarjeta: semana y navegacion ---
cabTarjeta = "<div class='ui-week-nav' role='group' aria-label='Cambiar de semana'>" & _
	"<a class='ui-button ui-button--light ui-button--sm' href='" & urlSemana & (epochLunes - 7) & "' aria-label='Semana anterior'>&#8592;</a>"
If mostrandoSemanaActual Then
	cabTarjeta = cabTarjeta & "<span class='ui-button ui-button--light ui-button--sm ui-button--disabled' aria-disabled='true' title='Ya est&aacute;s en la semana actual'>Hoy</span>"
Else
	cabTarjeta = cabTarjeta & "<a class='ui-button ui-button--light ui-button--sm' href='" & urlSemana & hoyEpoch & "'>Hoy</a>"
End If
cabTarjeta = cabTarjeta & "<a class='ui-button ui-button--light ui-button--sm' href='" & urlSemana & (epochLunes + 7) & "' aria-label='Semana siguiente'>&#8594;</a></div>"
xhtml = xhtml & UiCardAbre("Semana del " & rangoLbl, cabTarjeta)

' --- Leyenda ---
xhtml = xhtml & "<ul class='ui-week-leyenda' aria-label='Referencias'>" & _
	"<li><span class='ui-week-muestra ui-week-reunion--pendiente'></span>Pendiente</li>" & _
	"<li><span class='ui-week-muestra ui-week-reunion--postergada'></span>Postergada</li>" & _
	"<li><span class='ui-week-muestra ui-week-reunion--realizada'></span>Realizada</li>" & _
	"<li><span class='ui-week-flag ui-week-flag--leyenda' aria-hidden='true'>!</span>Cruce de horario: un participante tiene otra reuni&oacute;n en el mismo horario</li>" & _
	"</ul>"

xhtml = xhtml & "<div class='ui-week-body'>"
xhtml = xhtml & "<div class='ui-week-calendario'>"

' --- Cabecera de dias ---
xhtml = xhtml & "<div class='ui-week-cabecera-dias'><div class='ui-week-gutter' aria-hidden='true'></div>"
For i = 0 To 4
	Dim esHoy, diaEpoch, claseDia, nomFer
	diaEpoch = epochLunes + i
	esHoy = (diaEpoch = hoyEpoch)
	If esHoy Then claseDia = "ui-week-dia ui-week-dia--hoy" Else claseDia = "ui-week-dia"
	nomFer = ""
	If dicFer.Exists(CStr(diaEpoch)) Then nomFer = dicFer(CStr(diaEpoch))
	If nomFer <> "" Then claseDia = claseDia & " ui-week-dia--feriado"
	xhtml = xhtml & "<div class='" & claseDia & "'" & IIf(nomFer <> "", " title='" & Server.HTMLEncode(nomFer) & "'", "") & "><span class='ui-week-lbl'>" & NOMBRES_DIA(i) & "</span><span class='ui-week-num'>" & Day(CDate(diaEpoch + CLng(EPOCH))) & "</span>"
	If esHoy Then xhtml = xhtml & "<span class='ui-sr-only'>(hoy)</span>"
	If nomFer <> "" Then xhtml = xhtml & "<span class='ui-week-feriado'>" & Server.HTMLEncode(nomFer) & "</span>"
	xhtml = xhtml & "</div>"
Next
xhtml = xhtml & "</div>"

' --- Grilla de horas ---
' La grilla se desplaza: con tabindex se puede recorrer con teclado
xhtml = xhtml & "<div class='ui-week-grilla-wrap' id='grillaWrap' tabindex='0' role='region' aria-label='Horario de la semana'>"
xhtml = xhtml & "<div class='ui-week-gutter-horas' style='height:" & alturaGrilla & "px;' aria-hidden='true'>"
Dim hIdx
For hIdx = HORA_START To HORA_END - 1
	xhtml = xhtml & "<div class='ui-week-hora' style='top:" & ((hIdx - HORA_START) * ROW_H) & "px;'>" & Right("0" & hIdx, 2) & ":00</div>"
Next
xhtml = xhtml & "</div>"
xhtml = xhtml & "<div class='ui-week-columnas'>"

Dim jsMeetings
jsMeetings = ""

For i = 0 To 4
	xhtml = xhtml & "<div class='ui-week-dia-col" & IIf(dicFer.Exists(CStr(epochLunes + i)), " ui-week-dia-col--feriado", "") & "' style='height:" & alturaGrilla & "px;'>"

	Dim hy
	For hy = 0 To (HORA_END - HORA_START)
		xhtml = xhtml & "<div class='ui-week-linea-hora' style='top:" & (hy * ROW_H) & "px;'></div>"
	Next

	If (epochLunes + i) = hoyEpoch And ahoraDecimal >= HORA_START And ahoraDecimal < HORA_END Then
		xhtml = xhtml & "<div class='ui-week-linea-ahora' id='lineaAhora' style='top:" & CssNum((ahoraDecimal - HORA_START) * ROW_H) & "px;'><span class='ui-week-punto'></span></div>"
	End If

	Dim arrDia, nArrDia
	Select Case i
		Case 0
			arrDia = diaArr0
			nArrDia = nDia0
		Case 1
			arrDia = diaArr1
			nArrDia = nDia1
		Case 2
			arrDia = diaArr2
			nArrDia = nDia2
		Case 3
			arrDia = diaArr3
			nArrDia = nDia3
		Case 4
			arrDia = diaArr4
			nArrDia = nDia4
	End Select

	For j = 0 To nArrDia - 1
		Dim rm, top, height, widthPct, leftPct, claseEstado, hasCruce, cruceDic, claseBorde, etiquetaReu, estiloLic, colorLic, esLicencia
		Set rm = arrDia(j)
		top = (rm("hi") - HORA_START) * ROW_H + 2
		height = (rm("hf") - rm("hi")) * ROW_H - 4
		widthPct = 100 / rm("cols")
		leftPct = rm("col") * widthPct
		claseEstado = EstadoClase(rm("estado"))
		estiloLic = ""
		esLicencia = rm.Exists("esLic")
		If esLicencia Then
			' Licencia: rayas diagonales con el color de la persona (cada persona tiene el suyo, igual que su avatar)
			colorLic = ColorPersona(rm("respId"))
			estiloLic = LicEstilo(colorLic)
		End If

		Set cruceDic = rm("cruces")
		hasCruce = (cruceDic.Count > 0)
		claseBorde = ""
		If hasCruce Then claseBorde = " ui-week-reunion--cruce"

		' Nombre accesible: asunto, horario, estado y aviso de cruce
		etiquetaReu = Server.HTMLEncode(rm("asunto")) & ", " & FormatHoraDecimal(rm("hi")) & " a " & FormatHoraDecimal(rm("hf")) & ", " & LCase(rm("estado"))
		If esLicencia Then etiquetaReu = Server.HTMLEncode(rm("asunto")) & ", todo el d&iacute;a, licencia"
		If hasCruce Then etiquetaReu = etiquetaReu & ", con cruce de horario"

		xhtml = xhtml & "<button type='button' class='ui-week-reunion " & claseEstado & claseBorde & "' onclick='seleccionarReunion(" & rm("id") & ", this)' aria-label='" & etiquetaReu & "' " & _
			"style='top:" & CssNum(top) & "px;height:" & CssNum(height) & "px;left:calc(" & CssNum(leftPct) & "% + 2px);width:calc(" & CssNum(widthPct) & "% - 4px);" & estiloLic & "'>"
		If hasCruce Then xhtml = xhtml & "<span class='ui-week-flag' aria-hidden='true'>!</span>"
		xhtml = xhtml & "<span class='ui-week-titulo'>" & Server.HTMLEncode(rm("asunto")) & "</span>"
		If esLicencia Then
			xhtml = xhtml & "<span class='ui-week-hora-lbl'>Todo el d&iacute;a</span>"
		Else
			xhtml = xhtml & "<span class='ui-week-hora-lbl'>" & FormatHoraDecimal(rm("hi")) & "&ndash;" & FormatHoraDecimal(rm("hf")) & "</span>"
		End If
		xhtml = xhtml & "<span class='ui-week-avatares' aria-hidden='true'>"
		If Trim(rm("respId") & "") <> "" And CStr(rm("respId")) <> "0" Then
			xhtml = xhtml & "<span class='ui-week-avatar' style='background:" & ColorPersona(rm("respId")) & ";'>" & Iniciales(rm("respNombre")) & "</span>"
		End If
		Dim listaPp, pp
		listaPp = rm("participantes")
		For Each pp In listaPp
			xhtml = xhtml & "<span class='ui-week-avatar' style='background:" & ColorPersona(pp("id")) & ";'>" & Iniciales(pp("nombre")) & "</span>"
		Next
		xhtml = xhtml & "</span></button>"

		' [UI] Datos para el panel de detalle: JsRegistroReunion (la misma funcion que la vista mensual)
		'[UI-ANT] Dim jsParticipantes, cruceLista, idKey
		'[UI-ANT] jsParticipantes = ""
		'[UI-ANT] If Trim(rm("respId") & "") <> "" And CStr(rm("respId")) <> "0" Then
			'[UI-ANT] jsParticipantes = jsParticipantes & "{id:'" & JsStr(rm("respId")) & "',nombre:'" & JsStr(rm("respNombre")) & "',rol:'Responsable',cruce:" & CruceExiste(cruceDic, rm("respId")) & "},"
		'[UI-ANT] End If
		'[UI-ANT] For Each pp In listaPp
			'[UI-ANT] jsParticipantes = jsParticipantes & "{id:'" & JsStr(pp("id")) & "',nombre:'" & JsStr(pp("nombre")) & "',rol:'Participante',cruce:" & CruceExiste(cruceDic, pp("id")) & "},"
		'[UI-ANT] Next

		'[UI-ANT] cruceLista = ""
		'[UI-ANT] For Each idKey In cruceDic.Keys
			'[UI-ANT] Dim detalles, det, nombrePersona, campos
			'[UI-ANT] nombrePersona = NombrePorId(rm, idKey)
			'[UI-ANT] detalles = Split(cruceDic(idKey), Chr(29))
			'[UI-ANT] For Each det In detalles
				'[UI-ANT] campos = Split(det, Chr(28))
				'[UI-ANT] cruceLista = cruceLista & "{persona:'" & JsStr(nombrePersona) & "',otroTitulo:'" & JsStr(campos(1)) & "',otroHorario:'" & JsStr(FormatHoraDecimal(HHMMaDecimal(campos(2)))) & "\u2013" & JsStr(FormatHoraDecimal(HHMMaDecimal(campos(3)))) & "'},"
			'[UI-ANT] Next
		'[UI-ANT] Next

		'[UI-ANT] jsMeetings = jsMeetings & "'" & rm("id") & "':{id:" & rm("id") & ",titulo:'" & JsStr(rm("asunto")) & "',estado:'" & JsStr(rm("estado")) & "',fechaLabel:'" & JsStr(NOMBRES_DIA(i) & " " & Day(CDate((epochLunes + i) + CLng(EPOCH)))) & "',horaLabel:'" & JsStr(FormatHoraDecimal(rm("hi")) & " a " & FormatHoraDecimal(rm("hf"))) & "',personas:[" & jsParticipantes & "],cruces:[" & cruceLista & "]},"
		jsMeetings = jsMeetings & JsRegistroReunion(rm)
	Next

	xhtml = xhtml & "</div>"
Next

xhtml = xhtml & "</div></div></div>" ' Fin columnas, grilla y calendario

' --- Panel de detalle ---
xhtml = xhtml & "<section class='ui-week-panel' id='panel' aria-live='polite' aria-label='Detalle de la reuni&oacute;n'>"
xhtml = xhtml & "<div class='ui-week-vacio' id='panelVacio'>"
xhtml = xhtml & "<svg viewBox='0 0 24 24' width='36' height='36' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg>"
xhtml = xhtml & "<p>Eleg&iacute; una reuni&oacute;n del calendario para ver el detalle y si alg&uacute;n participante tiene otra reuni&oacute;n en el mismo horario.</p>"
xhtml = xhtml & "</div>"
xhtml = xhtml & "<div id='panelContenido' hidden></div>"
xhtml = xhtml & "</section>"   ' [UI] section con nombre (antes aside dentro del contenido principal)
xhtml = xhtml & "</div>" ' Fin ui-week-body

If totalReal = 0 Then xhtml = xhtml & "<p class='ui-table__nota'>No hay reuniones esta semana.</p>"
xhtml = xhtml & UiCardCierra()
End If
xhtml = xhtml & UiPantallaCierra()

' --- Scripts ---
' [UI] Pop-up de lectura del sistema (funciones.inc): muestra la reunion completa al tocar la descripcion
xhtml = xhtml & HtmlDialogoLectura()
xhtml = xhtml & "<script>"
xhtml = xhtml & "var REUNIONES = {" & jsMeetings & "};"
If mostrandoSemanaActual Then
	xhtml = xhtml & "var MOSTRANDO_HOY = true;"
Else
	xhtml = xhtml & "var MOSTRANDO_HOY = false;"
End If
' [UI] 'Abrir reunion' le pasa la vista y la fecha que se miraba, para que Volver regrese ahi
xhtml = xhtml & "var URL_ABRIR = 'agenda.asp?opc=det&xmenu=" & JsStr(Server.URLEncode(xmenu)) & "&xtmenu=" & JsStr(Server.URLEncode(xtmenu)) & "&vuelta=" & IIf(esMes, "mes", "semana") & "&vd=" & epochRef & "&id=';"
xhtml = xhtml & "var PALETA_JS = ['#0F5CA8','#6B4FA0','#0E6B0E','#A8410B','#3F6F05','#9A2D8F','#7A5807','#005E50'];"
xhtml = xhtml & "function colorPersona(id){ var s = String(id == null ? '' : id); if (!s || s === '0') return '#6B6966'; var h = 0; for (var i = 0; i < s.length; i++) { h = (h + s.charCodeAt(i)) % 8; } return PALETA_JS[h]; }"
xhtml = xhtml & "function iniciales(nombre){ var p = (nombre || '').trim().split(' '), o = ''; for (var i = 0; i < p.length && o.length < 2; i++) { if (p[i]) o += p[i].charAt(0).toUpperCase(); } return o || '?'; }"
xhtml = xhtml & "function escapeHtml(s){ var d = document.createElement('div'); d.appendChild(document.createTextNode(s || '')); return d.innerHTML; }"
xhtml = xhtml & "function claseEstado(e){ e = (e || '').toUpperCase(); return e === 'PENDIENTE' ? 'blue' : (e === 'POSTERGADA' ? 'amber' : 'gray'); }"
xhtml = xhtml & "function seleccionarReunion(id, boton){"
xhtml = xhtml & "  var r = REUNIONES[id]; if (!r) return;"
xhtml = xhtml & "  Array.prototype.forEach.call(document.querySelectorAll('.ui-week-reunion.is-sel, .ui-mes__reunion.is-sel'), function (b) { b.classList.remove('is-sel'); b.removeAttribute('aria-current'); });"
xhtml = xhtml & "  if (boton) { boton.classList.add('is-sel'); boton.setAttribute('aria-current', 'true'); }"
xhtml = xhtml & "  document.getElementById('panelVacio').hidden = true;"
xhtml = xhtml & "  var c = document.getElementById('panelContenido'); c.hidden = false;"
xhtml = xhtml & "  if (r.esLic) { var hl = '<span class=""ui-badge ui-badge--amber"">Licencia</span><h3 class=""ui-week-panel__titulo"">' + escapeHtml(r.persona) + '</h3><p class=""ui-week-panel__cuando"">' + escapeHtml(r.fechaLabel) + ' &middot; Todo el d\u00eda</p><p class=""ui-week-panel__seccion"">Per\u00edodo</p><p>' + escapeHtml(r.periodo) + '</p><p class=""ui-week-panel__seccion"">Motivo</p><p>' + escapeHtml(r.motivo || 'Sin motivo cargado.') + '</p>'; c.innerHTML = hl; return; }"
xhtml = xhtml & "  var h = '<span class=""ui-badge ui-badge--' + claseEstado(r.estado) + '"">' + escapeHtml(r.estado.charAt(0) + r.estado.slice(1).toLowerCase()) + '</span>';"
xhtml = xhtml & "  h += '<h3 class=""ui-week-panel__titulo"">' + escapeHtml(r.titulo) + '</h3>';"
xhtml = xhtml & "  h += '<p class=""ui-week-panel__cuando"">' + escapeHtml(r.fechaLabel) + ' &middot; ' + escapeHtml(r.horaLabel) + '</p>';"
' [UI] Descripcion de la reunion: 3 renglones; al tocarla abre el pop-up con la reunion completa (como los avances)
xhtml = xhtml & "  h += '<p class=""ui-week-panel__seccion"">Descripci\u00f3n de la reuni\u00f3n</p>';"
xhtml = xhtml & "  if (r.descripcion) { h += '<button type=""button"" class=""ui-week-desc"" onclick=""verReunionCompleta(' + r.id + ', this)""><span class=""ui-sr-only"">Ver la reuni\u00f3n completa: </span><span class=""ui-week-desc__texto"">' + escapeHtml(r.descripcion) + '</span></button>'; }"
xhtml = xhtml & "  else { h += '<p class=""ui-week-rol"">Sin descripci\u00f3n cargada.</p>'; }"
xhtml = xhtml & "  h += '<p class=""ui-week-panel__seccion"">Participantes</p><ul class=""ui-week-personas"">';"
xhtml = xhtml & "  for (var i = 0; i < r.personas.length; i++) { var p = r.personas[i];"
xhtml = xhtml & "    h += '<li><span class=""ui-week-avatar ui-week-avatar--lg"" style=""background:' + colorPersona(p.id) + '"" aria-hidden=""true"">' + iniciales(p.nombre) + '</span><span class=""ui-week-persona"">' + escapeHtml(p.nombre) + '<span class=""ui-week-rol"">' + p.rol + '</span></span>';"
xhtml = xhtml & "    if (p.cruce) h += '<span class=""ui-badge ui-badge--red"">Cruce</span>';"
xhtml = xhtml & "    h += '</li>'; }"
xhtml = xhtml & "  if (!r.personas.length) h += '<li class=""ui-week-rol"">Sin participantes cargados.</li>';"
xhtml = xhtml & "  h += '</ul><p class=""ui-week-panel__seccion"">Cruce de horario</p>';"
xhtml = xhtml & "  if (r.cruces.length) { for (var j = 0; j < r.cruces.length; j++) { var x = r.cruces[j];"
xhtml = xhtml & "    h += '<div class=""ui-week-cruce""><strong>' + escapeHtml(x.persona) + '</strong> tiene otra reuni\u00f3n en ese horario: &ldquo;' + escapeHtml(x.otroTitulo) + '&rdquo; (' + escapeHtml(x.otroHorario) + ').</div>'; } }"
xhtml = xhtml & "  else { h += '<div class=""ui-week-sin-cruce"">Ning\u00fan participante tiene otra reuni\u00f3n en ese horario.</div>'; }"
xhtml = xhtml & "  h += '<a class=""ui-button ui-button--primary ui-week-abrir"" href=""' + URL_ABRIR + r.id + '"">Abrir reuni\u00f3n</a>';"
xhtml = xhtml & "  c.innerHTML = h;"
xhtml = xhtml & "}"
' [UI] Reunion completa en el pop-up de lectura (titulo, fecha, estado, personas y descripcion completa)
xhtml = xhtml & "function verReunionCompleta(id, origen){ var r = REUNIONES[id]; if (!r) return;"
xhtml = xhtml & "  var resp = [], part = []; for (var i = 0; i < r.personas.length; i++) { (r.personas[i].rol === 'Responsable' ? resp : part).push(r.personas[i].nombre); }"
xhtml = xhtml & "  UiVerCampos(r.titulo, [['Fecha y horario', r.fechaLabel + ' \u00b7 ' + r.horaLabel], ['Estado', r.estado.charAt(0) + r.estado.slice(1).toLowerCase()], ['Responsable', resp.join(', ')], ['Participantes', part.join(', ')], ['Descripci\u00f3n de la reuni\u00f3n', r.descripcion, true]], origen); }"
xhtml = xhtml & "window.addEventListener('load', function(){"
xhtml = xhtml & "  if (!MOSTRANDO_HOY) return;"
xhtml = xhtml & "  var linea = document.getElementById('lineaAhora'), wrap = document.getElementById('grillaWrap');"
xhtml = xhtml & "  if (linea && wrap) { wrap.scrollTop = Math.max(0, linea.offsetTop - (wrap.clientHeight / 2)); }"
xhtml = xhtml & "});"
xhtml = xhtml & "</script>"

xhtml = xhtml & "<script src='assets/js/jquery.min.js'></script>"
xhtml = xhtml & "<script src='assets/js/skel.min.js'></script>"
xhtml = xhtml & "<script src='assets/js/util.js'></script>"
xhtml = xhtml & "<script src='assets/js/main.js'></script>"
xhtml = xhtml & "</body></html>"

Response.Write xhtml

Cnn.Close
Set Cnn = Nothing
%>
