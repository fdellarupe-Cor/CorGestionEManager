<!-- #INCLUDE FILE="IncFile/funciones.inc" -->
<!-- #INCLUDE FILE="IncFile/ui_componentes.inc" -->
<!-- #INCLUDE FILE="IncFile/agenda_ext.inc" -->
<!-- #INCLUDE FILE="IncFile/feriados.inc" -->
<%
' ============================================================================
' agenda_semana.asp
' Pantalla flotante (popup) "Agenda - Vista semanal": calendario tipo
' Outlook/Teams con las reuniones de la semana y sus participantes.
' Para cada reunion PENDIENTE/POSTERGADA valida cruces de horario llamando a
' dbo.sp_Agenda_ValidarCruceHorario por cada responsable/participante del
' sistema.
' Parametros: d = fecha de referencia (DIAS desde 1900-01-01, mismo formato
' que AGENDA.FECHA_REUNION); xmenu/xtmenu = contexto de menu para volver a
' agenda.asp. Se abre con window.open() desde agenda_ext.inc.
' ============================================================================

Dim i, j
Dim listaPart(), nPart, dicP
Dim personas(), nPersonas, k, listaP
Dim xmenu, xtmenu
xmenu = Request.QueryString("xmenu") & ""
xtmenu = Request.QueryString("xtmenu") & ""

Dim Cnn
Set Cnn = Server.CreateObject("ADODB.Connection")
On Error Resume Next
Cnn.Open scon1
If Err.Number <> 0 Then
	Response.Write "<div style='color:red;font-family:monospace;padding:10px;border:1px solid red;margin:10px;'>"
	Response.Write "<b>ERROR DE CONEXION A BASE DE DATOS</b><br>"
	Response.Write "Codigo: " & Err.Number & "<br>"
	Response.Write "Detalle: " & Server.HTMLEncode(Err.Description) & "</div>"
	Response.End
End If
On Error Goto 0

' --- Semana a mostrar (lunes a viernes) a partir del parametro "d" ---
Dim EPOCH, epochRef, fechaRefDate, diaSemana, epochLunes, epochDesde, epochHasta, hoyEpoch
EPOCH = CDate("01-01-1900")
hoyEpoch = AgendaExtHoy()
' OJO: IsNumeric(Empty) = True en VBScript. Sin el "& """ un "d" ausente
' daba epochRef = 0 y la vista mostraba la semana del 1/1/1900.
Dim dParam
dParam = Trim(Request.QueryString("d") & "")
If dParam <> "" And IsNumeric(dParam) Then
	epochRef = CLng(dParam)
Else
	epochRef = hoyEpoch
End If
fechaRefDate = CDate(CLng(epochRef) + CLng(EPOCH))
diaSemana = Weekday(fechaRefDate, vbMonday) ' 1=lunes .. 7=domingo
epochLunes = epochRef - (diaSemana - 1)
epochDesde = epochLunes
epochHasta = epochLunes + 4 ' lunes..viernes

' [UI] Vista: semanal (por defecto) o mensual (?vista=mes). El mes muestra lunes a viernes, desde la semana
' del dia 1 hasta la del ultimo dia (si caen sabado o domingo, la semana habil siguiente o anterior).
' Usa la misma carga de reuniones, participantes y cruces que la semana: solo cambia el rango.
Dim vistaAg, esMes, dPrimero, dUltimo, epochMesIni, epochMesFin, wdIni, wdFin
vistaAg = LCase(Trim(Request.QueryString("vista") & ""))
esMes = (vistaAg = "mes")
If esMes Then
	dPrimero = DateSerial(Year(fechaRefDate), Month(fechaRefDate), 1)
	dUltimo = DateSerial(Year(fechaRefDate), Month(fechaRefDate) + 1, 0)
	epochMesIni = CLng(dPrimero) - CLng(EPOCH)
	epochMesFin = CLng(dUltimo) - CLng(EPOCH)
	wdIni = Weekday(dPrimero, vbMonday)
	If wdIni >= 6 Then epochDesde = epochMesIni + (8 - wdIni) Else epochDesde = epochMesIni - (wdIni - 1)
	wdFin = Weekday(dUltimo, vbMonday)
	If wdFin >= 6 Then epochHasta = epochMesFin - (wdFin - 5) Else epochHasta = epochMesFin + (5 - wdFin)
	epochLunes = epochDesde
End If

' Feriados de la semana (CG_FERIADOS; si no hay ninguno se confirma con la API y se actualiza la tabla)
Dim dicFer
Set dicFer = FeriadosAsegurar(Cnn, epochDesde, epochHasta)

Dim NOMBRES_DIA(4)
NOMBRES_DIA(0) = "LUN" : NOMBRES_DIA(1) = "MAR" : NOMBRES_DIA(2) = "MI&Eacute;" : NOMBRES_DIA(3) = "JUE" : NOMBRES_DIA(4) = "VIE"

' --- Helpers ---
Function HHMMaDecimal(v)
	If Not IsNumeric(v) Then
		HHMMaDecimal = 0
	Else
		HHMMaDecimal = Int(CLng(v) / 100) + (CLng(v) Mod 100) / 60
	End If
End Function

Function FormatHoraDecimal(v)
	Dim hh, mm
	hh = Int(v)
	mm = Round((v - hh) * 60)
	FormatHoraDecimal = Right("0" & hh, 2) & ":" & Right("0" & mm, 2)
End Function

' Numero para CSS con punto decimal. CStr() usa el separador del idioma del
' servidor (coma en espanol) y "18,43px" es CSS invalido.
Function CssNum(v)
	CssNum = Replace(CStr(Round(CDbl(v), 2)), ",", ".")
End Function

Function JsStr(s)
	Dim t
	t = s & ""
	t = Replace(t, "\", "\\")
	t = Replace(t, "'", "\'")
	t = Replace(t, vbCrLf, "\n")
	t = Replace(t, vbCr, "\n")
	t = Replace(t, vbLf, "\n")
	t = Replace(t, "</", "<\/")   ' [UI] un texto con </script> no corta el script de la pagina
	JsStr = t
End Function

Dim PALETA(7)
'[UI-ANT] PALETA(0) = "#0f6cbd" : PALETA(1) = "#8764b8" : PALETA(2) = "#107c10" : PALETA(3) = "#ca5010"
' [UI] Paleta con contraste suficiente para las iniciales en blanco (antes un tono quedaba en 4.5:1 y el gris en 3.5:1)
PALETA(0) = "#0F5CA8" : PALETA(1) = "#6B4FA0" : PALETA(2) = "#0E6B0E" : PALETA(3) = "#A8410B"
'[UI-ANT] PALETA(4) = "#498205" : PALETA(5) = "#c239b3" : PALETA(6) = "#986f0b" : PALETA(7) = "#005e50"
' [UI] Paleta con contraste suficiente para las iniciales en blanco (antes un tono quedaba en 4.5:1 y el gris en 3.5:1)
PALETA(4) = "#3F6F05" : PALETA(5) = "#9A2D8F" : PALETA(6) = "#7A5807" : PALETA(7) = "#005E50"

Function ColorPersona(idPersona)
	Dim s, h, j
	s = Trim(idPersona & "")
	If s = "" Or s = "0" Then
		'[UI-ANT] ColorPersona = "#8a8886"
' [UI] Paleta con contraste suficiente para las iniciales en blanco (antes un tono quedaba en 4.5:1 y el gris en 3.5:1)
		ColorPersona = "#6B6966"
	Else
		h = 0
		For j = 1 To Len(s)
			h = (h + Asc(Mid(s, j, 1))) Mod 8
		Next
		ColorPersona = PALETA(h)
	End If
End Function

Function Iniciales(nombre)
	Dim partes, ini, i
	partes = Split(Trim(nombre & ""), " ")
	ini = ""
	For i = 0 To UBound(partes)
		If Trim(partes(i)) <> "" And Len(ini) < 2 Then ini = ini & UCase(Left(partes(i), 1))
	Next
	If ini = "" Then ini = "?"
	Iniciales = ini
End Function

' Clase CSS de estado (definida en assets/css/corgestion-ui.css): resuelve
' fondo, texto y borde izquierdo de la reunion en la grilla.
Function EstadoClase(estado)
	Select Case UCase(estado & "")
		Case "PENDIENTE": EstadoClase = "ui-week-reunion--pendiente"
		Case "POSTERGADA": EstadoClase = "ui-week-reunion--postergada"
		Case "REALIZADA": EstadoClase = "ui-week-reunion--realizada"
		Case Else: EstadoClase = "ui-week-reunion--realizada"
	End Select
End Function

' Color de texto (hex) del estado, usado solo en el panel lateral (JS).
Function EstadoColorTextoJs(estado)
	Select Case UCase(estado & "")
		Case "PENDIENTE": EstadoColorTextoJs = "#0f4778"
		Case "POSTERGADA": EstadoColorTextoJs = "#6b4e00"
		Case "REALIZADA": EstadoColorTextoJs = "#484644"
		Case Else: EstadoColorTextoJs = "#484644"
	End Select
End Function

' --- Trae reuniones + corresponsables de la semana (2 resultsets) ---
' IMPORTANTE: hay que agotar el primer resultset (reuniones) ANTES de pedir
' NextRecordset(), porque ADO descarta las filas no leidas del resultset
' actual al avanzar al siguiente.
Dim rsReu, rsCorr
Set rsReu = Exec(Cnn, "sp_cg_Agenda_VistaSemanal @FechaDesde=" & epochDesde & ", @FechaHasta=" & epochHasta)

' --- Arma la coleccion de reuniones (Dictionary por reunion), sin participantes todavia ---
Dim dicReuniones, ordenIds, totalReuniones
Set dicReuniones = Server.CreateObject("Scripting.Dictionary")
totalReuniones = 0
ReDim ordenIds(2000)

Dim HORA_START, HORA_END
HORA_START = 8
HORA_END = 20

Do While Not rsReu.EOF
	Dim m, idReu
	Set m = Server.CreateObject("Scripting.Dictionary")
	idReu = CLng(rsReu("ID"))
	m.Add "id", idReu
	m.Add "asunto", rsReu("ASUNTO") & ""
	m.Add "fecha", CLng(rsReu("FECHA_REUNION"))
	m.Add "hi", HHMMaDecimal(rsReu("HORA_INICIO"))
	m.Add "hf", HHMMaDecimal(rsReu("HORA_FIN"))
	m.Add "estado", rsReu("ESTADO_AGENDA") & ""
	m.Add "respId", rsReu("ID_RESPONSABLE") & ""
	m.Add "respNombre", rsReu("RESPONSABLE") & ""
	If Trim(m("respNombre")) = "" Then m("respNombre") = "(sin responsable)"
	m.Add "hiInt", CLng(rsReu("HORA_INICIO"))
	m.Add "hfInt", CLng(rsReu("HORA_FIN"))
	' [UI] Descripcion de la reunion: DATO NUEVO. [LOGICA] el companero lo suma a sp_cg_Agenda_VistaSemanal con el nombre DESCRIPCION.
	' Mientras la columna no exista queda vacio y el panel muestra 'Sin descripcion cargada'.
	m.Add "descripcion", CampoRs(rsReu, "DESCRIPCION")

	If m("hi") < HORA_START Then HORA_START = Int(m("hi"))
	Dim techo
	techo = Int(m("hf"))
	If m("hf") > techo Then techo = techo + 1
	If techo > HORA_END Then HORA_END = techo

	dicReuniones.Add CStr(idReu), m
	ordenIds(totalReuniones) = CStr(idReu)
	totalReuniones = totalReuniones + 1
	rsReu.MoveNext
Loop
ReDim Preserve ordenIds(totalReuniones)

' --- Ahora si, el segundo resultset: corresponsables de esas reuniones ---
Set rsCorr = rsReu.NextRecordset()

' --- Agrupa corresponsables por ID_AGENDA: dicCorr(idAgenda) = "idPersona|nombre" Chr(9) ... ---
Dim dicCorr, claveAgenda
Set dicCorr = Server.CreateObject("Scripting.Dictionary")
If Not rsCorr Is Nothing Then
	If Not rsCorr.State = 0 Then
		Do While Not rsCorr.EOF
			claveAgenda = CStr(rsCorr("ID_AGENDA"))
			If Not dicCorr.Exists(claveAgenda) Then dicCorr.Add claveAgenda, ""
			dicCorr(claveAgenda) = dicCorr(claveAgenda) & (rsCorr("ID_PERSONA") & "") & "|" & (rsCorr("NOMBRE") & "") & Chr(9)
			rsCorr.MoveNext
		Loop
	End If
End If

' --- Tercer resultset: licencias del rango. Cada dia laborable (lunes a viernes) cubierto por una licencia se agrega
' como una "reunion" de dia completo (estado LICENCIA), en la semana y en el mes. Si el procedimiento todavia no
' devuelve este resultado (falta DB/Cambios_Agenda_Licencias.sql), la agenda se muestra igual, sin licencias. ---
Dim totalReal, rsLic, licIni, licFin, licDia, licKey, mLic, licNombre, licPer, licId
totalReal = totalReuniones
Set rsLic = Nothing
On Error Resume Next
If Not rsCorr Is Nothing Then Set rsLic = rsCorr.NextRecordset()
If Err.Number <> 0 Then
	Err.Clear
	Set rsLic = Nothing
End If
On Error Goto 0
If Not rsLic Is Nothing Then
	If rsLic.State <> 0 Then
		Do While Not rsLic.EOF
			licId = CLng(rsLic("ID"))
			licIni = CLng("0" & rsLic("F_INICIO"))
			licFin = CLng("0" & rsLic("F_FIN"))
			If licFin < licIni Then licFin = licIni
			licNombre = Trim(rsLic("PERSONA") & "")
			If licNombre = "" Then licNombre = Trim(rsLic("ID_PERSONA") & "")
			licPer = FormatDateTime(CDate(licIni + CLng(EPOCH)), 2)
			If licFin <> licIni Then licPer = licPer & " al " & FormatDateTime(CDate(licFin + CLng(EPOCH)), 2)
			For licDia = epochDesde To epochHasta
				If licDia >= licIni And licDia <= licFin And Weekday(CDate(licDia + CLng(EPOCH)), vbMonday) <= 5 Then
					licKey = -(licId * 100 + (licDia - epochDesde))   ' id negativo y unico por licencia y dia (no choca con las reuniones)
					If Not dicReuniones.Exists(CStr(licKey)) Then
						Set mLic = Server.CreateObject("Scripting.Dictionary")
						mLic.Add "id", licKey
						mLic.Add "asunto", "Licencia: " & licNombre
						mLic.Add "fecha", licDia
						mLic.Add "hi", HORA_START
						mLic.Add "hf", HORA_END
						mLic.Add "estado", "LICENCIA"
						mLic.Add "respId", rsLic("ID_PERSONA") & ""
						mLic.Add "respNombre", licNombre
						mLic.Add "hiInt", HORA_START * 100
						mLic.Add "hfInt", HORA_END * 100
						mLic.Add "esLic", True
						mLic.Add "motivo", rsLic("MOTIVO") & ""
						mLic.Add "periodo", licPer
						mLic.Add "descripcion", ""
						dicReuniones.Add CStr(licKey), mLic
						ReDim Preserve ordenIds(totalReuniones + 1)
						ordenIds(totalReuniones) = CStr(licKey)
						totalReuniones = totalReuniones + 1
					End If
				End If
			Next
			rsLic.MoveNext
		Loop
		rsLic.Close
	End If
End If

' --- Segunda pasada: adjunta la lista de participantes a cada reunion ---
For i = 0 To totalReuniones - 1
	Dim mAttach, idReuAttach, partesCorr, p, nombreP, idP
	Set mAttach = dicReuniones(ordenIds(i))
	idReuAttach = mAttach("id")

	nPart = 0
	ReDim listaPart(200)
	If dicCorr.Exists(CStr(idReuAttach)) Then
		partesCorr = Split(dicCorr(CStr(idReuAttach)), Chr(9))
		For Each p In partesCorr
			If Trim(p) <> "" Then
				idP = Split(p, "|")(0)
				nombreP = Split(p, "|")(1)
				Set dicP = Server.CreateObject("Scripting.Dictionary")
				dicP.Add "id", idP
				dicP.Add "nombre", nombreP
				Set listaPart(nPart) = dicP
				nPart = nPart + 1
			End If
		Next
	End If
	' Sin participantes (por ejemplo una licencia): se guarda un array vacio nuevo. No se asigna Array() a listaPart
	' porque listaPart es un array redimensionado (ReDim) y esa asignacion da "No coinciden los tipos".
	If nPart = 0 Then
		mAttach.Add "participantes", Array()
	Else
		ReDim Preserve listaPart(nPart - 1)
		mAttach.Add "participantes", listaPart
	End If
	mAttach.Add "nParticipantes", nPart
Next

If Not rsReu Is Nothing Then If rsReu.State <> 0 Then rsReu.Close
If Not rsCorr Is Nothing Then If rsCorr.State <> 0 Then rsCorr.Close

' --- Valida cruces de horario con sp_Agenda_ValidarCruceHorario ---
' Para cada reunion PENDIENTE/POSTERGADA, valida al responsable y a cada
' participante del sistema (con ID_PERSONA numerico) contra el resto de la
' agenda, excluyendo la propia reunion.
For i = 0 To totalReuniones - 1
	Dim mm
	Set mm = dicReuniones(ordenIds(i))
	Dim dicCruces
	Set dicCruces = Server.CreateObject("Scripting.Dictionary") ' clave = idPersona, valor = array de detalles (texto con separadores)
	mm.Add "cruces", dicCruces

	If UCase(mm("estado")) = "PENDIENTE" Or UCase(mm("estado")) = "POSTERGADA" Then
		Dim horaIniInt, horaFinInt, fechaInt
		fechaInt = mm("fecha")
		horaIniInt = mm("hiInt")
		horaFinInt = mm("hfInt")

		nPersonas = 0
		ReDim personas(mm("nParticipantes") + 1)
		If Trim(mm("respId") & "") <> "" Then
			If Trim(mm("respId") & "") <> "0" Then
				personas(nPersonas) = mm("respId")
				nPersonas = nPersonas + 1
			End If
		End If
		listaP = mm("participantes")
		For k = 0 To UBound(listaP)
			If Trim(listaP(k)("id") & "") <> "" Then
				If Trim(listaP(k)("id") & "") <> "0" Then
					personas(nPersonas) = listaP(k)("id")
					nPersonas = nPersonas + 1
				End If
			End If
		Next

		For k = 0 To nPersonas - 1
			Dim idPersonaChk, rsCruce, detalleCruce
			idPersonaChk = CStr(personas(k))
			Set rsCruce = Exec(Cnn, "sp_cg_Agenda_ValidarCruceHorario @IdResponsable=" & SqlStr(idPersonaChk) & ", @FechaReunion=" & fechaInt & ", @HoraInicio=" & horaIniInt & ", @HoraFin=" & horaFinInt & ", @IdAgendaExcluir=" & mm("id"))
			detalleCruce = ""
			Do While Not rsCruce.EOF
				If detalleCruce <> "" Then detalleCruce = detalleCruce & Chr(29)
				detalleCruce = detalleCruce & (rsCruce("ID_AGENDA_CRUCE") & "") & Chr(28) & (rsCruce("ASUNTO") & "") & Chr(28) & (rsCruce("HORA_INICIO") & "") & Chr(28) & (rsCruce("HORA_FIN") & "") & Chr(28) & (rsCruce("ROL") & "")
				rsCruce.MoveNext
			Loop
			rsCruce.Close
			If detalleCruce <> "" Then dicCruces.Add CStr(idPersonaChk), detalleCruce
		Next
	End If
Next

' --- Agrupa por dia de semana (0=lunes..4=viernes), ordena por hora y asigna columnas para solapados ---
Sub AsignarColumnas(arr, n)
	Dim ii, kk, jj, colAsignada, activeColsUsed, clusterCount, clusterEnd
	Dim activeCols(60), clusterMembers(60)
	activeColsUsed = 0 : clusterCount = 0 : clusterEnd = -1
	For ii = 0 To n - 1
		Dim mi
		Set mi = arr(ii)
		If clusterCount > 0 And mi("hi") >= clusterEnd Then
			For jj = 0 To clusterCount - 1
				clusterMembers(jj)("cols") = activeColsUsed
			Next
			clusterCount = 0 : activeColsUsed = 0 : clusterEnd = -1
		End If
		colAsignada = -1
		For kk = 0 To activeColsUsed - 1
			If activeCols(kk) <= mi("hi") Then
				colAsignada = kk
				Exit For
			End If
		Next
		If colAsignada = -1 Then
			colAsignada = activeColsUsed
			activeColsUsed = activeColsUsed + 1
		End If
		activeCols(colAsignada) = mi("hf")
		mi("col") = colAsignada
		Set clusterMembers(clusterCount) = mi
		clusterCount = clusterCount + 1
		If mi("hf") > clusterEnd Then clusterEnd = mi("hf")
	Next
	If clusterCount > 0 Then
		For jj = 0 To clusterCount - 1
			clusterMembers(jj)("cols") = activeColsUsed
		Next
	End If
End Sub

' Se agrupa en 5 arrays independientes (uno por dia Lun..Vie)
Dim diaArr0(), diaArr1(), diaArr2(), diaArr3(), diaArr4()
Dim nDia0, nDia1, nDia2, nDia3, nDia4
nDia0 = 0 : nDia1 = 0 : nDia2 = 0 : nDia3 = 0 : nDia4 = 0
ReDim diaArr0(500) : ReDim diaArr1(500) : ReDim diaArr2(500) : ReDim diaArr3(500) : ReDim diaArr4(500)

For i = 0 To totalReuniones - 1
	Dim mrec, dow
	Set mrec = dicReuniones(ordenIds(i))
	dow = mrec("fecha") - epochDesde
	Select Case dow
		Case 0: Set diaArr0(nDia0) = mrec : nDia0 = nDia0 + 1
		Case 1: Set diaArr1(nDia1) = mrec : nDia1 = nDia1 + 1
		Case 2: Set diaArr2(nDia2) = mrec : nDia2 = nDia2 + 1
		Case 3: Set diaArr3(nDia3) = mrec : nDia3 = nDia3 + 1
		Case 4: Set diaArr4(nDia4) = mrec : nDia4 = nDia4 + 1
	End Select
Next

' Ordena cada dia por hora de inicio (insertion sort simple)
Sub OrdenarPorHora(arr, n)
	Dim ii, jj
	For ii = 1 To n - 1
		Dim actual
		Set actual = arr(ii)
		jj = ii - 1
		Do While jj >= 0
			If arr(jj)("hi") > actual("hi") Then
				Set arr(jj + 1) = arr(jj)
				jj = jj - 1
			Else
				Exit Do
			End If
		Loop
		Set arr(jj + 1) = actual
	Next
End Sub

OrdenarPorHora diaArr0, nDia0 : AsignarColumnas diaArr0, nDia0
OrdenarPorHora diaArr1, nDia1 : AsignarColumnas diaArr1, nDia1
OrdenarPorHora diaArr2, nDia2 : AsignarColumnas diaArr2, nDia2
OrdenarPorHora diaArr3, nDia3 : AsignarColumnas diaArr3, nDia3
OrdenarPorHora diaArr4, nDia4 : AsignarColumnas diaArr4, nDia4

Dim ROW_H
ROW_H = 58
Dim alturaGrilla
alturaGrilla = (HORA_END - HORA_START) * ROW_H

Dim ahoraDecimal, mostrandoSemanaActual
ahoraDecimal = Hour(Now()) + Minute(Now()) / 60
mostrandoSemanaActual = (hoyEpoch >= epochDesde And hoyEpoch <= epochHasta)

Dim volverUrl, nuevaUrl
volverUrl = "agenda.asp?xmenu=" & Server.URLEncode(xmenu) & "&xtmenu=" & Server.URLEncode(xtmenu)
nuevaUrl = "agenda.asp?opc=edicion&xmenu=" & Server.URLEncode(xmenu) & "&xtmenu=" & Server.URLEncode(xtmenu)
' [UI] '+ Nueva reunion' tambien vuelve a la vista de origen (vuelta y vd los define mas abajo el selector de vista)
nuevaUrl = nuevaUrl & "&vuelta=" & IIf(LCase(Trim(Request.QueryString("vista") & "")) = "mes", "mes", "semana") & "&vd=" & epochRef

' [UI] Lee una columna del recordset si existe (si no, vacio). Para datos nuevos que todavia no devuelve el SP.
Function CampoRs(rs, nombre)
	Dim f
	CampoRs = ""
	For Each f In rs.Fields
		If UCase(f.Name) = UCase(nombre) Then
			CampoRs = f.Value & ""
			Exit Function
		End If
	Next
End Function

' [UI] Nombre completo del dia y fecha para el panel ("Miercoles 21 de octubre"). Sin entidades HTML:
' el panel escapa el texto (antes un miercoles se veia "MI&Eacute; 21").
Function FechaLargaTexto(epochDia)
	Dim dd, nombres
	dd = CDate(CLng(epochDia) + CLng(EPOCH))
	nombres = Array("Lunes", "Martes", "Mi" & ChrW(233) & "rcoles", "Jueves", "Viernes", "S" & ChrW(225) & "bado", "Domingo")
	FechaLargaTexto = nombres(Weekday(dd, vbMonday) - 1) & " " & Day(dd) & " de " & MESES_ES(Month(dd) - 1)
End Function

' [UI] Registro de una reunion para el panel de detalle (lo usan la vista semanal y la mensual)
Function JsRegistroReunion(rm)
	Dim jsPart, cLista, idK, dets, de, nomP, cps, lstP, p2, cd
	If rm.Exists("esLic") Then
		JsRegistroReunion = "'" & rm("id") & "':{id:" & rm("id") & ",esLic:true,estado:'LICENCIA',persona:'" & JsStr(rm("respNombre")) & "',titulo:'" & JsStr(rm("asunto")) & "',fechaLabel:'" & JsStr(FechaLargaTexto(rm("fecha"))) & "',horaLabel:'Todo el d\u00eda',periodo:'" & JsStr(rm("periodo")) & "',motivo:'" & JsStr(rm("motivo")) & "',descripcion:'',personas:[],cruces:[]},"
		Exit Function
	End If
	Set cd = rm("cruces")
	jsPart = ""
	If Trim(rm("respId") & "") <> "" And CStr(rm("respId")) <> "0" Then
		jsPart = jsPart & "{id:'" & JsStr(rm("respId")) & "',nombre:'" & JsStr(rm("respNombre")) & "',rol:'Responsable',cruce:" & CruceExiste(cd, rm("respId")) & "},"
	End If
	lstP = rm("participantes")
	For Each p2 In lstP
		jsPart = jsPart & "{id:'" & JsStr(p2("id")) & "',nombre:'" & JsStr(p2("nombre")) & "',rol:'Participante',cruce:" & CruceExiste(cd, p2("id")) & "},"
	Next
	cLista = ""
	For Each idK In cd.Keys
		nomP = NombrePorId(rm, idK)
		dets = Split(cd(idK), Chr(29))
		For Each de In dets
			cps = Split(de, Chr(28))
			cLista = cLista & "{persona:'" & JsStr(nomP) & "',otroTitulo:'" & JsStr(cps(1)) & "',otroHorario:'" & JsStr(FormatHoraDecimal(HHMMaDecimal(cps(2)))) & "\u2013" & JsStr(FormatHoraDecimal(HHMMaDecimal(cps(3)))) & "'},"
		Next
	Next
	JsRegistroReunion = "'" & rm("id") & "':{id:" & rm("id") & ",titulo:'" & JsStr(rm("asunto")) & "',estado:'" & JsStr(rm("estado")) & "',fechaLabel:'" & JsStr(FechaLargaTexto(rm("fecha"))) & _
		"',horaLabel:'" & JsStr(FormatHoraDecimal(rm("hi")) & " a " & FormatHoraDecimal(rm("hf"))) & "',descripcion:'" & JsStr(rm("descripcion")) & "',personas:[" & jsPart & "],cruces:[" & cLista & "]},"
End Function

' [CG] Estilo de una licencia: rayas diagonales con el color de la persona
Function LicEstilo(colorLic)
	LicEstilo = "background:repeating-linear-gradient(135deg," & colorLic & "33 0," & colorLic & "33 8px,#ffffff 8px,#ffffff 16px);border-left:4px solid " & colorLic & ";color:#0f172a;"
End Function

' [UI] Pestana Semanal / Mensual (la misma barra de pildoras que Consultas y Reportes)
Function AgTab(valor, texto, actual)
	Dim url
	url = "agenda_semana.asp?vista=" & valor & "&xmenu=" & Server.URLEncode(xmenu) & "&xtmenu=" & Server.URLEncode(xtmenu) & "&d=" & epochRef
	If valor = actual Then
		AgTab = "<a class='ui-tabbar__link is-active' aria-current='page' href='" & url & "'>" & texto & "</a>"
	Else
		AgTab = "<a class='ui-tabbar__link' href='" & url & "'>" & texto & "</a>"
	End If
End Function

Function CruceExiste(dic, idPersona)
	If dic.Exists(CStr(idPersona)) Then
		CruceExiste = "true"
	Else
		CruceExiste = "false"
	End If
End Function

Function NombrePorId(rm, idBuscado)
	If CStr(rm("respId")) = CStr(idBuscado) Then
		NombrePorId = rm("respNombre")
		Exit Function
	End If
	Dim lst, pp2
	lst = rm("participantes")
	For Each pp2 In lst
		If CStr(pp2("id")) = CStr(idBuscado) Then
			NombrePorId = pp2("nombre")
			Exit Function
		End If
	Next
	NombrePorId = "Persona #" & idBuscado
End Function

