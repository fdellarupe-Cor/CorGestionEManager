Function armaCombo(sql,cn,clave,valor,texto,comboid)

	Set nrs = cn.Execute(sql)

	xhtml = xhtml & "<select class='selec' style='width:70%;' id='" & comboid & "' name='" & comboid & "'>"

	if comboid = "uau" then
		xhtml = xhtml & "<option value='0' selected>TODOS</option>"
	else
		xhtml = xhtml & "<option value='0' selected>SIN DATOS</option>"
	end if

	Do While Not nrs.eof

		If clave = nrs(valor) Then

			xhtml = xhtml & "<option value='" & nrs(valor) & "' selected>" & nrs(texto) & "</option>"

		Else

			xhtml = xhtml & "<option value='" & nrs(valor) & "'>" & nrs(texto) & "</option>"

		End If

		nrs.movenext
	Loop

	xhtml = xhtml & "</select>"

	armaCombo = xhtml

End Function

Function getResp(cn,xid)

	Set irs = cn.Execute("sp_Responsables @Modo='nombre_id', @Id=" & xid)

	xResp = ""
	if not irs.eof then
		xResp = irs(0)
	else
		xResp = "TODOS"
	end if
	getResp = xResp

End Function

Function getCantInc(cn,sid,stipo)

	if stipo = "TEC" then
		Set xi = cn.Execute("sp_Registro_Contar @Tabla='incidentes', @Campo='respon_tec', @IdRespon=" & sid)
	elseif stipo = "FUNC" then
		Set xi = cn.Execute("sp_Registro_Contar @Tabla='incidentes', @Campo='respon_gestion', @IdRespon=" & sid)
	end if

	sCantInc = ""
	if not xi.eof then sCantInc = xi(0)

	getCantInc = sCantInc

End Function

Function getCantProy(cn,sid,stipo)

	if stipo = "TEC" then
		Set xp = cn.Execute("sp_Registro_Contar @Tabla='proyectos', @Campo='respon_tec', @IdRespon=" & sid)
	elseif stipo = "FUNC" then
		Set xp = cn.Execute("sp_Registro_Contar @Tabla='proyectos', @Campo='respon_gestion', @IdRespon=" & sid)
	end if

	sCantProy = ""
	if not xp.eof then sCantProy = xp(0)

	getCantProy = sCantProy

End Function

