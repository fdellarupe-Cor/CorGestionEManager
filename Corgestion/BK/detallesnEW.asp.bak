html = html & "<script type='text/javascript' src='assets/js/jquery-ui.js'></script>"
html = html & "</head>"
html = html & "<body>"

Set Cnn = Server.CreateObject("ADODB.Connection")
Cnn.ConnectionString = "Provider=SQLOLEDB;Data Source=server-2025;Initial Catalog=dbcorgestionv5; user id=sa;password=bb4515$;"
