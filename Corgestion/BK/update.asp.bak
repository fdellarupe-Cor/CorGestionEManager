<!-- #INCLUDE FILE="IncFile/funciones.inc" -->
<%
Set Cnn = Server.CreateObject("ADODB.Connection")
Cnn.open scon1

sPadre = request.querystring("padre")
sDato = request.querystring("dato")
sTipo = request.querystring("tipo")

if sTipo = "INC" then

	select case sPadre

		case "licli"
			sql = "id_cliente"

		case "liaplic"
			sql = "id_aplic"

		case "lirg"
			sql = "respon_gestion"

		case "lirp"
			sql = "req_presup"

		case "livp"
			sql = "via_pedido"

		case "librow"
			sql = "browser"

		case "liprio"
			sql = "prioridad"

		case "lirt"
			sql = "respon_tec"

		case "licon"
			sql = "contacto"

		case "iTit"
			sql = "titulo"

		case "iDeta"
			sql = "detalles"

	End Select

Cnn.Execute("sp_Registro_ActualizarCampos @tabla='INCIDENTES', @id=" & session("ID") & ", @camposJson='[{""col"":""" & sql & """,""val"":""" & sDato & """}]'")

Elseif sTipo = "ELIM" then

	Cnn.Execute("sp_Registro_Eliminar @Opt='incf', @Id=" & session("ID"))

end if

response.write request.querystring

%>