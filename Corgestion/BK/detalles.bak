html = html & "<body>"

'fini = clng(Date())-clng(CDate("01-01-1900"))
'response.write(fini)
'response.write(GTFechadorsh(fini))
Set Cnn = Server.CreateObject("ADODB.Connection")
Cnn.Open scon1
'response.write request.querystring



id = request.querystring("id")
