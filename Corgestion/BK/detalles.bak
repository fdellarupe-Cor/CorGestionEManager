			html = html & "<td><font style='margin-left:5%;font-size:20pt;font-family:Serif;color:#000000;letter-spacing:0.2em;'><b>'" & LEFT(titP,40) & "'</b></font></td>"

		Else

			html = html & "<td><font style='margin-left:1%;font-size:10pt;font-family:helvetica;color:#000000;yletter-spacing:0.2em;line-height:35px;'>" & ucase(LEFT(titP,40)) & "</font></td>"

		End If

