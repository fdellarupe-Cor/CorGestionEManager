if aplicativo & "" = "" then aplicativo = request.querystring("apli")
if aplicativo & "" = "" then aplicativo = 0


ord = request.querystring("ord")
orden = ""

select case ord

	case "titulo"

		 orden = "order by a.titulo"

	case "cliente"

		 orden = "order by a.id_cliente"

	case "aplicativo"

		orden = "order by a.id"
end select

