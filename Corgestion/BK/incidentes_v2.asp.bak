if cantregmover <> 0 then
	formx22 = "<form id='formx22' style='height:1px;' method='post' action='incidentes.asp?opc=listar&cantregmover=" & (cantregmover - cantregmostrar) & "&ord=" & ord & "&cli=" & cli & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'></form>"
	botonx22 = "<input class='bot' type='button' value='ATRAS' onclick=""document.getElementById('formx22').submit();"">"
else
