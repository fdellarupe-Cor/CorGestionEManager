	html = html & "<td class='encabe' style='width:15%;'><a class='red' href='incidentes.asp?ord=cliente&cli=" & cliente & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'>CLIENTE</a></td>"
