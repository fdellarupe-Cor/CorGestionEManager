		'if getPermisos(xmenu,xtmenu,"CONS") = 1 then
		'	botonx3 = "<input class='bot' style='background:#DAE8FF;color:#008520;' type='button' value='D' onclick=""document.getElementById('formx3" & rs(0) & "').submit();"">"
		'else
		'	botonx3 = "<input class='botsp' type='button' value='D' onclick=""alert('Sin permiso para consultar.');"">"
		'end if

		html = html & "<tr>"
		html = html & "<td class='regis'>" & botonx1 & "</td>"

		if session("USUARIO") = rs(6) or session("USUARIO") = rs(7) then
			html = html & "<td class='regis' >" & botonx2 & "</td>"
		else
			html = html & "<td class='regis' ></td>"
		end if

		'html = html & "<td class='regis' >" & botonx3 & "</td>"
		html = html & "<td class='regis' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'"">" & rs(0) & "</td>"

		if rs(7) <> 0 then
			html = html & "<td class='regis' title='" & rs(11) & "' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'"">" & Left(UCASE(rs(11)),40) & "</td>"
		else
			html = html & "<td class='regis' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'"">" & Left(UCASE(rs(11)),40) & " <font style='color:#000FFF;'><b>(C)</b></font></td>"
		end if

		html = html & "<td class='regis' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'"">" & rs(1) & "</td>"
		
		html = html & "<td class='regis' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'"">" & prio & "</td>"

		html = html & "<td class='regis' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'"">" & rs(12) & "</td>"
				
		if rs(5) <> 0 then
			html = html & "<td class='regis' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'""><font style='font-size:12pt;'>" & est1 & "</font></td>"
		else
			html = html & "<td class='regis' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'""><font style='font-size:12pt;'>-------------</td>"
		end if

		html = html & "<td class='regis' onclick=""document.location='http://server-2025/corgestionv5/detalles.asp?id=" & rs(0) & "&opc=veri&cli=" & cliente & "&tit=" & tit & "&xmenu=" & xmenu & "&xtmenu=" & xtmenu & "'""><font style='font-size:12pt;'>" & est2 & "</font></td>"
		sFec = Fechador(rs(5) + nFecini)
