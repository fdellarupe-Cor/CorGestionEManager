'response.write "5" & "<br>"
             STRSQL = "insert into SEGCKTRESP (SEGCKT,SEGCKTPSC,MODO,TIPO,CODIGO,ORDEN,NIVEL,SUBCODIGO,SEGEMAIL,codempre,sector) values "
             STRSQL = STRSQL & " ('" & SESSION("SEGCKT") & "','" & RS3(5) & "','L','USR','" & RS1(4) & "','" & XORDEN & "','" & SUPLEVL & "','" & SESSION("SECTORIG") & "','" & session("SGU_MAIL") & "','"  & rs1(14) & "','')"
'response.write strsql & "<br>"
             call ofv.crearconsultaEx(StrSql,cn,1,parametros)

       RS1.MOVENEXT

       LOOP



    IF session("TCliente") = "RSK" THEN
    ELSEIF sacc="PEDIDOOK" THEN



         sql="select GRPUSR from pedidoSDKdet  where codobjeto=0 and tipobjeto='" & session("TCliente") & "' order by objid "


        ' response.write sql  & "<br>" & chr(13)
         set rx =  ofv.crearconsultaEx(sql,CN3,1,volver)

         DO WHILE NOT  rx.EOF
          XORDEN = XORDEN + 10
		  XINDT = XINDT + 1
         ' XUSUC=mid( rx(4)& "" ,5,len(rx(4)) &"" )
           P_WKFAPRO=mid( rx(0)& "" ,5,len(rx(0)) &"" )
