             ATABLA(XINDT,6) =  XORDEN
'response.write "3" & "<br>"
             strsql = "insert into SEGCKTRESP (SEGCKT,SEGCKTPSC,MODO,TIPO,CODIGO,ORDEN,NIVEL,SUBCODIGO,SEGEMAIL,codempre) values "
             STRSQL = STRSQL & " ('" & SESSION("SEGCKT") & "','" & RS3(5) & "','L','SEC','" & SESSION("SECTORIG") & "','" & XORDEN & "','" & SUPLEVL & "','" & SESSION("SECTGEREN") & "','NO','')"
'             response.write strsql & "<br>"
             call ofv.crearconsultaEx(StrSql,cn,1,parametros)

     ELSE

       XORDEN = XORDEN + 10
       xxx = getinfouser(SESSION("USUARIO"))
'response.write "4" & "<br>"
       STRSQL = "insert into SEGCKTRESP (SEGCKT,SEGCKTPSC,MODO,TIPO,CODIGO,ORDEN,NIVEL,SUBCODIGO,SEGEMAIL,codempre,sector) values "
       STRSQL = STRSQL & " ('" & SESSION("SEGCKT") & "','" & RS3(5) & "','L','USR','" & SESSION("USUARIO") & "','" & XORDEN & "','" & session("SegNivel") & "','0','" & session("SGU_MAIL") & "','" & session("CLIEMP") & "','" & session("UsrSector") & "')"
'       response.write strsql & "<br>"
       call ofv.crearconsultaEx(StrSql,cn,1,parametros)

          ATABLA(XINDT,0) =  "L"
          ATABLA(XINDT,1) =  SESSION("USUARIO")
          ATABLA(XINDT,2) =  "USR"
          ATABLA(XINDT,3) =  RS3(5)
          ATABLA(XINDT,4) =  session("SegNivel")
          ATABLA(XINDT,5) =  "0"
          ATABLA(XINDT,6) =  xorden
     END IF



  '  END IF


