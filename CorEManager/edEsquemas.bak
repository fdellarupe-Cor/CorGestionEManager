  if not rs.eof then
     sEsquema = rs(1)
     siconmas = rs("archivo")
  end if

  call ofv.cerrarconsulta(rs)

  Strsql = "Select * From Objetos Where codobjeto=" & nCodigo
  set rs = ofv.crearconsultaEx(StrSql,cn,1,parametros)
  if not rs.eof THEN


  bstitulox = sEsquema & ": " & rs(1) & " - " & rs(3)
  h1 = "<IMG SRC=Iconos\" & siconmas & " border=0>"
  END IF
  call ofv.cerrarconsulta(rs)


    '  Formulario = ""

'      Celda = ofv.GenCelda("","","","1%","","","",h1,"si")
'      Celda = Celda & ofv.GenCelda("","et colspan=9","","99%","","","","<b><u>" & bstitulox & "</u></b>","si")

'      Formulario = Formulario & ofv.GenRow("","","","","","","",Celda,"si")


  Formulario = ""

  Celda      = ofv.GenCelda("","ttt COLSPAN=6 ","","","","","","<big>LISTA DE ESQUEMAS</BIG>","si")
  Formulario = Formulario & ofv.GenRow("","","","","","","",Celda,"si")



  Strsql = "Select * From Objeven Where codobjeto=" & nCodigo & " Order By secuen"
  set rs1 = ofv.crearconsultaEx(StrSql,cn,1,parametros)
  do until rs1.eof
        sicK = "<font face='CorFlaticon' size=4 color='" & session("cmfmenu") & "' >&#57433;</font>&nbsp;"


   if bModificar then
      sAccion = "edesquemas.asp?Codobjeto="
