      sInput = ofv.GenerarInput("","+","submit","","10","bt title='Agregar esquema para " & rs1(3) & "' ","")
      Celda = ofv.GenCelda("","","","","","","",sInput,"si")
      Agregar = ofv.GenForm("Agre","",sAccion,"_self","post","",Celda,"si")

      sinput  = "<a class='nt'  href='"
