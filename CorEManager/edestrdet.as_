      'Secuencia
      select case stip
             case "A"
                  btip = "TIT"
                  btipi = sImageTit
                  btipp = "TITULO"
                  bseci = 0
                  bsecix = 0
                  bsec(1) = ars(4,inx)

             case "B"
                  btip = "ST1"
                  btipi = sImageSt1
                  btipp = "SUBTITULO 1"
                  bseci = 1
                  bsecix = 1
                  bsec(2) = ars(4,inx)



             case "C"
                  btip = "ST2"
                  btipi = sImageSt2
                  btipp = "SUBTITULO 2"
                  bseci = 2
                  bsecix = 2
                  bsec(3) = ars(4,inx)
             case "D"
                  btip = "ST3"
                  btipi = sImageSt3
                  btipp = "SUBTITULO 3"
                  bseci = 3
                  bsecix = 3
                  bsec(4) = ars(4,inx)
             case "E"
                  btip = "ST4"
                  btipi = sImageSt4
                  btipp = "SUBTITULO 4"
                  bseci = 4
                  bsecix = 4
                  bsec(5) = ars(4,inx)
             case "F"
                  btip = "ST5"
                  btipi = sImageSt5
                  btipp = "SUBTITULO 5"
                  bseci = 5
                  bsecix = 5
                  bsec(6) = ars(4,inx)
             case "G"
                  btip = "TXT"
                  btipi = sImageItG
                  btipp = "TEXTO"
                  select case sant
                         case "A"
                              bseci = 0
                         case "B"
                              bseci = 1
                         case "C"
                              bseci = 2
                         case "D"
                              bseci = 3
                         case "E"
                              bseci = 4
                         case "F"
                              bseci = 5
                  end select
                  bsecix = bseci + 1
                  bsec(7) = ars(4,inx)
             case "H"
                  btip = "IMG"
                  btipi = sImageItH
                  btipp = "IMAGEN"
                  select case sant
                         case "A"
                              bseci = 0
                         case "B"
                              bseci = 1
                         case "C"
                              bseci = 2
                         case "D"
                              bseci = 3
                         case "E"
                              bseci = 4
                         case "F"
                              bseci = 5
                  end select
                  bsecix = bseci + 1
                  bsec(7) = ars(4,inx)
             case "I"
                  btip = "TAB"
                  btipi = sImageItI
                  btipp = "TABLA"
                  select case sant
                         case "A"
                              bseci = 0
                         case "B"
                              bseci = 1
                         case "C"
                              bseci = 2
                         case "D"
                              bseci = 3
                         case "E"
                              bseci = 4
                         case "F"
                              bseci = 5
                  end select
                  bsecix = bseci + 1
                  bsec(7) = ars(4,inx)
             case "J"
                  btip = "CMP"
                  btipi = sImageItJ
                  btipp = "COMPONENTE"
                  select case sant
                         case "A"
                              bseci = 0
                         case "B"
                              bseci = 1
                         case "C"
                              bseci = 2
                         case "D"
                              bseci = 3
                         case "E"
                              bseci = 4
                         case "F"
                              bseci = 5
                  end select
                  bsecix = bseci + 1
                  bsec(7) = ars(4,inx)

      end select
      Amk = "<a name=" & chr(34) & "X" & ars(0,inx) & chr(34) & "> "
      amkey = ars(0,inx)

      Fila        = ""
      Formulario  = ""
      Formulario1 = ""
      Formulario2 = ""

     'Eliminar
      sHref = ""
      if smodi And stipmodi = "E" then


        sImage = ofv.GenImage("","","","","Imagenes/Botdelx.jpg","0","")
        Celda = ofv.GenCelda("","","","","","","",sImage ,"si")
      else
        if bModificar then
           if cstr(amkeya) = cstr(0) then
               vlk = vuelta
           else
               vlk = vuelta & "_pmk=" & amkeya
           end if
          if smodi And stipmodi = "A" then
            sHref = "asp/EliminarEN.asp?ID=" & SCLAVE & "&Tabla=Objestdet&volver=" & vlk
            sHref = sHref & "&Codobjeto=" & nCodigo & "&Tipobjeto=" & sTipo & "&Eliminar=SI"
          else
            sHref = "asp/ActualizarEN.asp?ID=" & SCLAVE & "&Tabla=Objestdet&volver=" & vlk
            sHref = sHref & "&Codobjeto=" & nCodigo & "&Tipobjeto=" & sTipo & "&Eliminar=SI"
          end if
        end if
        if sHref <> "" then

           'Celtmp = BotonEliminar(BtipP & "xxx",sHref)
           Celtmp = BotonEliminar(BtipP ,sHref,SCLAVE)

