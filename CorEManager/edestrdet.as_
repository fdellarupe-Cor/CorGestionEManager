 if not rs.eof then

    if cantregmover > 0  then rs.move cantregmover

     if not rs.eof then
       ars = rs.GetRows(cint(CantRegMostrar)+1,0)
     else
       redim  ars(cint(campos),0)
       ars(39,0) = "N"
     end if

 else

    redim  ars(cint(campos),0)

    ars(39,0) = "N"

 end if

xsfii=0
