 '' response.write "<BIGGER>"

  response.write "<TABLE  width=100%  marginwidth=0  cellspacing=0  cellpadding=2 >" & CHR(13)

'''''''''''''''''''''''

    'secuencia
      if OSec <> "SI" then

        'Secuencia Oculta
         sAccion = "edEstrDet.asp?ID=" & ID & "&Codobjeto=" & nCodigo & "&Tipobjeto=" & sTipo
