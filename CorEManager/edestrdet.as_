      bsec(i) = 0
  next
  amkeya = 0
  wentro = 0



 inx = 0

 ' if not rs.eof then
 '    rs.move cantregmover
'  end if

 do while wentro = 0

    '  do while not rs.eof

for Inx = inx to UBound(ars,2)

         IF ars(39,inx) = "N" OR ((ars(40,inx) & "") = "" AND clng("0" & ars(6,inx)) > 0 )THEN
           inx = inx + 1
           exit for
         END IF


         SCLAVE    = ars(0,inx)
         Stip      = ars(5,inx)
         smodi     = ars(29,inx)
         stipmodi  = ars(30,inx)
