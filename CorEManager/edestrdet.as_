Set Rs = Server.CreateObject("ADODB.Recordset")
Rs.CursorType = 3
Rs.CacheSize = 15
'Rs.Cursorlocation = 3
Rs.Open strsql, cn

  for inx = 0 to (rs.fields.count - 1)
      nrs(inx) = rs(inx).name
  next

