        'RESPONSE.WRITE STRSQL
        set rs = ofv.crearconsultaEx(StrSql,cn,1,parametros)

       IF RS("PENDIENTES") & "" = "0" AND RS("OWNER")& "" = "" THEN
          SESSION("COMENTARIOS")="N"
        ELSEIF   RS("OWNER")& "" <> ""  AND RS("PENDIENTES") & "" <> "0"  THEN
          SESSION("COMENTARIOS")="S1"
        ELSEIF RS("OWNER")& "" <> ""  AND RS("PENDIENTES") & "" = "0" THEN
           SESSION("COMENTARIOS")="S2"
        ELSE
         SESSION("COMENTARIOS")="N"

       END IF

      call ofv.cerrarconsulta(rs)
    end if


  xestado = 1
