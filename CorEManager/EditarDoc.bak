  Strsql = "Select * From Objperfil Where tipoperfil='" & sPerfil & "'"
  set rs = ofv.crearconsultaEx(StrSql,cn,1,parametros)
  if not rs.eof then
  Solapas = 1
  for z = 2 to 12
    if rs(z) Then
       Solapas = Solapas + 1
    end if
  next
  end if
  call ofv.cerrarconsulta(rs)

  if SESSION("COMENTARIOS")="S" AND session("ModMain")="ED" then
       STRSQL="select min(isnull(ACTPEND,0)) AS PENDIENTES ,ISNULL(MAX(A.AUTOR),'') AS OWNER from objprty a"
        STRSQL=  STRSQL & " INNER join OBJOBSCMT b on (b.codsol=9999 and b.tipo='CMD' AND a.codobjeto=b.codobjeto )"
