    if  cstr(rs(4)) <> "0" AND cstr(rs(3)) <> "0"  and bModificar then

        sinput = "<a class=cc style='text-decoration:none;background-color:none;' onmouseover='this.style.textDecoration=" & chr(34)
        sinput = sinput  & "underline" & chr(34) & ";this.style.backgroundColor=" & chr(34)
        sinput = sinput  & "#f7aa22" & chr(34) & ";' onmouseout='this.style.backgroundColor=" & chr(34)
        sinput = sinput  & "" & chr(34) & ";this.style.textDecoration=" & chr(34)
        sinput = sinput  & "none" & chr(34) & ";' "
        sinput = sinput  & "  href=EDPropiedadesMasIns.asp?codobjeto=" & Ncodigo & "&tipobjeto=" & stipo & "  "
        sinput = sinput  & "  TITLE='Agregar origenes de documento adicionales.'  ><b>&nbsp;" & sImagenI3 & "...&nbsp;</b></a>"
        SMASINS = sinput
    END IF

    'Identificacion del Instrumento
    Celda = ofv.GenCelda("","tt","","","","","","Ident.&nbsp;Instrumento","si")
    if bModificar then
      sInput = ofv.GenerarInput(rs(5).name,rs(5),"text",sForm,"50","dt","no")
    else
      sInput = ofv.GenerarInput("",rs(5),"readonly","","50","dt","")
    end if
    Celda = Celda & ofv.GenCelda("","uti colspan=2","","","","","",sInput & SMASINS,"si")
    Fila = Fila & ofv.GenRow("","","","","25","","",Celda,"si")

    'link
    Celda = ofv.GenCelda("","tt","","","","","","Link Instrumento","si")
    if bModificar then
      sInput = ofv.GenerarInput(rs(18).name,rs(18),"textsb",sForm,"80","dt","")
    else
