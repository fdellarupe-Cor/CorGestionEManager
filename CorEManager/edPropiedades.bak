  set rs = ofv.crearconsultaEx(StrSql,cn,1,parametros)
  bVersion = "NO"
  if not rs.eof then
    if rs(0) = "V" then bVersion = "SI"
  end if
  call ofv.cerrarconsulta(rs)

  Strsql = "SELECT OBJPRTY.*, Estados.estado FROM OBJPRTY, Estados "
