    Celda = ofv.GenCelda("","ttt colspan=3","","","","","","Fechas","si")
    Fila = Fila &  ofv.GenRow("","","","","25","","",Celda,"si")




    'Fecha de emision
    Celda = ofv.GenCelda("","tt","","","","","","Emision","si")

    if clng(rs(6)) = 0 then
