    'Fecha de acta
    Celda = ofv.GenCelda("","tt","","","","","","Acta","si")

    sInputD = ofv.GenerarInput(rs(16).name,rs(16).value,"HIDDEN",sForm,"1","dt","")

    if clng(rs(16)) = 0 then
