  set rs = ofv.crearconsultaEx(StrSql,cn,1,parametros)
  if not rs.eof Then

     sForm = "edPropiedades"

    'Estado
    Celda = ofv.GenCelda("","tt","","","","","","Estado","si")

    sInput = rs(21)
    Celda = Celda & ofv.GenCelda("","uti colspan=2","","","","","",sInput,"si")
