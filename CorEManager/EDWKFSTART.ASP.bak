              TIPOOBJ = RSX1(1)
           END IF


          SESSION("NOMREQ") = TIPOOBJ & " " & RS(2)
        END IF

     END IF

     SESSION("NOMREQ") = TIPOOBJ & " " & TIPOOBJ2

  END IF

