    WKFAUTOB = "WKF00016631121722600921928999"
    WKFAPROB = "WKF00016631121722600921928999"
    WKFAUTO  = "WKF00016631121722600921928999"
    WKFAPRO  = "WKF00016631121722600921928999"
  ELSE
    WKFAUTOB = "WKF00016631121722600921928"
