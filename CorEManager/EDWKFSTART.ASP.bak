    WKFAUTO  = "WKF00016631121722600921928"
    WKFAPRO  = "WKF00016631121722600921928"
   END IF

  DESLEVL = 9
  SUPLEVL = 9


  IF session("NCliente") <> "NO" THEN

     IF session("TCliente") = "RSK" THEN

         Strsql = "Select * From ORRSKCONFIG where APLIC = '" & WKAPLIC & "' "
