					 wkfmensaje = wkfmensaje & CHR(13) & CHR(13) & " <APLURL>INGRESAR A LA APLICACION</APLURL>"

                    ' wkfmensaje = UCASE(wkfmensaje)
                    else
			        wkfmensaje = "Se encuentra Disponible en la Aplicación " & Session("CorTitApli") & " un proyecto"
