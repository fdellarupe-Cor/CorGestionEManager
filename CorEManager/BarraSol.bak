'''''''''''''''''''''''''''''''
function ConvNumer(CNumero,CTipo)

CLetra = "abcdefghijklmnopqrstuvwxyz"

dim CRuni(9)
CRuni(1) = "I"
CRuni(2) = "II"
CRuni(3) = "III"
CRuni(4) = "IV"
CRuni(5) = "V"
CRuni(6) = "VI"
CRuni(7) = "VII"
CRuni(8) = "VIII"
CRuni(9) = "IX"

dim CRdec(9)
CRdec(1) = "X"
CRdec(2) = "XX"
CRdec(3) = "XXX"
CRdec(4) = "XL"
CRdec(5) = "L"
CRdec(6) = "LX"
CRdec(7) = "LXX"
CRdec(8) = "LXXX"
CRdec(9) = "XC"

dim CRcen(9)
CRcen(1) = "C"
CRcen(2) = "CC"
CRcen(3) = "CCC"
CRcen(4) = "CD"
CRcen(5) = "D"
CRcen(6) = "DC"
CRcen(7) = "DCC"
CRcen(8) = "DCCC"
CRcen(9) = "CM"


select case Ctipo
       case "a","A"
          Ci = 0
          CR = CNumero

             for ci=0 to 28
                 if CR < 28 then exit for
                 CR = CR - 27
             next

          if ci > 27 then
             ConvNumer = "XX"
          else
             if ci > 0 then ConvNumer = mid(CLetra,ci,1)
             ConvNumer = ConvNumer & mid(CLetra,CR,1)
          end if
          if Ctipo = "A" then ConvNumer = Ucase(ConvNumer)

       case "I","i"
          CR = CNumero
          Ci = len(CR)
          if Ci < 1 or ci > 3 then
             ConvNumer = "AAAA"
          else
             cx = 1
             for CL=ci to 1 step -1
             select case cx
                    case 1
                         ConvNumer = CRuni(mid(cr,cl,1))
                    case 2
                         ConvNumer = CRdec(mid(cr,cl,1)) & ConvNumer
                    case 3
                         ConvNumer = CRcen(mid(cr,cl,1)) & ConvNumer
             end select

             cx = cx + 1
             next
             if Ctipo = "i" then ConvNumer = Lcase(ConvNumer)
          end if
end select


end function


