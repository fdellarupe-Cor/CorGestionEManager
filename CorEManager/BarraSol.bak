            Celdat  = stexto1

          '  stexto1 = "<A ID='ASC" & rsxx1(0) & "' NAME='ASC" & rsxx1(0) & "' class=ut href='" & sAccion & "' " & sOnClik1 & " "
          '  stexto1 = stexto1 & "   >" & Celdat & "</a>"

