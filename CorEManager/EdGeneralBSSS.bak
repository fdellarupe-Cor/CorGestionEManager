Function LinkReemp(nObjrem,sTipo)
dim rsx

set cn2 = ofv.conectar(ofv.strconn2)

 strsql = "Select * From depenreemp Where codobj = '" & nCodigo & "' "
 strsql = strsql & "and tipobj = '" & sTipo & "' "
'response.write strsql & "<br>"
 set rsx = ofv.crearconsultaEx(StrSql,cn2,1,parametros)
 if not rsx.eof then
    Strsql = "Select * From csobjetosRDO where codobjeto = " & nObjrem
   'response.write strsql & "<br>"
    set rsx1 = ofv.crearconsultaEx(StrSql,cn2,1,parametros)
    if not rsx1.eof then

      wNomL = rsx1(1) & ": " & rsx1(2) & " - " & rsx1(3) & " - " & rsx1(5) & " - " & rsx1(6) & " - (" & rsx1(7) & ") "
      cod=rsx(0)
    else
      wNomL = "S/D"
    end if
  end if
  call ofv.cerrarconsulta(rsx)


    sActcon = "Consultar.asp?Codigo=" & id & "&Tipo=" & tipo
    sActcon = sActcon & "&Datos=*smenu=PORESTADO*lista=3"
   ' response.write sActcon
    sHref = "&nbsp;"


 'sFuncion = " onclick=" & Chr(34) & " AbrirCons('" & sActcon & "','" & id & "'); return false;" & Chr(34)
 'wNomL = "&nbsp; <b>" & wNomL & "</b> "
 'sImagen = wNomL
 'sLink = OFV.GenLink("", "nt title='Ver Documento.' ", sHref, "", "", sFuncion, sImagen, "si")
 'LinkReemp=sLink

 LinkReemp=wNomL




call ofv.cerrarconn(cn2)

 End Function

